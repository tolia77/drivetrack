@page "/"
@layout LandingLayout
@attribute [AllowAnonymous]
@inject ICurrentUser Caller
@inject IStringLocalizer<UiText> Localizer
@inject IUserService Users
@inherits CircuitScopedComponent

<PageTitle>DriveTrack</PageTitle>

@* FR-99: one landing page, two audiences.

   The public marketing page the design draws ("Landing page (public)"): its own header and footer
   rather than the application's sidebar - LandingLayout is the frame - and between them the hero,
   what a client gets, how a delivery goes, the questions clients ask first, and a last call to
   action.

   Written for the people who send parcels, in what happens to their parcel rather than in how the
   system runs it: no roles, no permissions, no state names, nothing about how staff accounts come
   to exist. Staff need only the way in, which the header already offers. Every claim is something a
   client can actually do or see - no prices, no promised delivery times, nothing about seeing the
   driver.

   The design draws the anonymous state, and the signed-in one beside it ("Landing header · signed
   in"): anyone with a session is shown who they are and offered one way into the application in
   place of every sign-in and register entry point on the page - the header, the hero, the footer -
   and the closing call to action, which exists only to sign somebody up, is not drawn at all. Where
   that way in goes belongs to LandingRoute, which is the one place that knows where a role lands,
   and the button names the place it goes to. Their name opens a small account menu - their own
   profile, and signing out - so a session started here can also be ended here.

   NFR-24: every action carries an icon AND its text. An icon on its own is a guess.

   Independent @if blocks rather than if/else, and ICurrentUser rather than <AuthorizeView>, so the
   signed-in branch can read the role it needs without a second notion of who the caller is. *@

<div class="dt-landing">
    <header class="dt-landing-header">
        <div class="dt-landing-wrap dt-landing-headrow">
            @* NFR-25: the shell's own lock-up - the same mark, the same glyph - so the page a visitor
               starts on and the frame they sign in to are recognisably one product. *@
            <a class="dt-landing-brand" href="#top">
                <span class="dt-nav__mark dt-icon-only"><Icon Name="IconName.Location" /></span>DriveTrack
            </a>

            <nav class="dt-landing-sections" aria-label="@Localizer["LandingSections"]">
                <a class="dt-landing-section-link" href="#features">@Localizer["LandingNavFeatures"]</a>
                <a class="dt-landing-section-link" href="#how">@Localizer["LandingNavHow"]</a>
                <a class="dt-landing-section-link" href="#faq">@Localizer["LandingNavFaq"]</a>
            </nav>

            <div class="dt-landing-account">
                @* The reading language, as the design draws it: a borderless button naming the
                   current one, opening a menu of both. Each choice is a submit button of one form
                   posting to /set-culture - the endpoint, the antiforgery token and the full-page
                   navigation are DtLanguageSwitch's, for the reason it gives: a cookie cannot be
                   written from a live circuit. The footer keeps that component as it was.

                   Both menus here are native popovers rather than state on the circuit: the browser
                   opens one on its button, closes it on Escape and on a click anywhere else, puts
                   its contents next in the tab order and tells assistive technology whether it is
                   expanded - all without a round trip or a script. Where the browser can anchor a
                   popover it is drawn under its button; where it cannot, it is drawn centred on the
                   screen, which is the platform's own fallback and still usable. *@
                <button class="dt-landing-menu-button dt-landing-menu-button--language" type="button"
                        popovertarget="dt-landing-language-menu"
                        aria-label="@LanguageButtonLabel">
                    <Icon Name="IconName.Language" />@CurrentLanguage<span class="dt-landing-chevron dt-icon-only"><Icon Name="IconName.Expand" /></span>
                </button>
                <div class="dt-landing-menu dt-landing-menu--language" id="dt-landing-language-menu" popover>
                    <form class="dt-lang" method="post" action="/set-culture">
                        <AntiforgeryToken />
                        <input type="hidden" name="returnUrl" value="/" />
                        <button class="dt-landing-menu-item" type="submit" name="culture" value="uk-UA"
                                aria-current="@CurrentWhen(IsUkrainian)">
                            <span class="dt-landing-menu-check"><Icon Name="IconName.Confirm" /></span>@Localizer["LanguageUkrainian"]
                        </button>
                        <button class="dt-landing-menu-item" type="submit" name="culture" value="en-US"
                                aria-current="@CurrentWhen(!IsUkrainian)">
                            <span class="dt-landing-menu-check"><Icon Name="IconName.Confirm" /></span>@Localizer["LanguageEnglish"]
                        </button>
                    </form>
                </div>

                <span class="dt-landing-divider" aria-hidden="true"></span>

                @* The person, as a borderless button opening their account menu: their profile, and
                   the sign-out POST the navigation uses. The claim set carries no display name, so
                   the name is the caller's own profile, read once and only for a signed-in caller.
                   If that read fails the menu stays and the name goes - the button is then the
                   profile glyph, named in words for assistive technology - because losing the way
                   out over a missing name would be worse than not greeting somebody. *@
                @if (Caller.IsAuthenticated)
                {
                    <button class="dt-landing-menu-button dt-landing-menu-button--account" type="button"
                            popovertarget="dt-landing-account-menu"
                            aria-label="@AccountButtonLabel">
                        @if (_me is not null)
                        {
                            <span class="dt-landing-me"><span class="dt-landing-avatar" aria-hidden="true">@Initials</span>@_me.FirstName @_me.LastName</span>
                        }
                        @if (_me is null)
                        {
                            <Icon Name="IconName.Profile" />
                        }
                        <span class="dt-landing-chevron dt-icon-only"><Icon Name="IconName.Expand" /></span>
                    </button>
                    <a class="btn btn-primary" href="@LandingRoute.For(Caller.Role)">@WayIn</a>

                    @* The menu comes after the way in in the source, though it opens under the person:
                       a popover is drawn in the top layer wherever it sits, and the browser puts its
                       contents next in the tab order after the button that opened it. *@
                    <div class="dt-landing-menu dt-landing-menu--account" id="dt-landing-account-menu" popover>
                        <a class="dt-landing-menu-item" href="/profile">
                            <Icon Name="IconName.Profile" />@Localizer["LandingMyProfile"]
                        </a>
                        <form method="post" action="/sign-out">
                            <AntiforgeryToken />
                            <button class="dt-landing-menu-item" type="submit">
                                <Icon Name="IconName.SignOut" />@Localizer["SignOut"]
                            </button>
                        </form>
                    </div>
                }

                @* Sign in is borderless here, as the design draws it: the header's one filled button
                   is the one it wants pressed. *@
                @if (!Caller.IsAuthenticated)
                {
                    <a class="btn dt-landing-ghost" href="sign-in">
                        <Icon Name="IconName.SignIn" />@Localizer["SignIn"]
                    </a>
                    <a class="btn btn-primary" href="register">
                        <Icon Name="IconName.Register" />@Localizer["LandingCreateAccount"]
                    </a>
                }
            </div>
        </div>
    </header>

    <main>
        <section class="dt-landing-section dt-landing-hero-section" id="top">
            <div class="dt-landing-wrap dt-landing-hero">
                <div class="dt-landing-pitch">
                    <h1 class="dt-type-display dt-landing-title">@Localizer["LandingHeroTitle"]</h1>

                    <p class="dt-landing-lead dt-muted">@Localizer["LandingHeroLead"]</p>

                    <div class="dt-landing-actions">
                        @if (Caller.IsAuthenticated)
                        {
                            <a class="btn btn-primary" href="@LandingRoute.For(Caller.Role)">@WayIn</a>
                        }

                        @if (!Caller.IsAuthenticated)
                        {
                            <a class="btn btn-primary" href="register">
                                <Icon Name="IconName.Register" />@Localizer["LandingCreateAccount"]
                            </a>
                            <a class="btn btn-outline-secondary" href="sign-in">
                                <Icon Name="IconName.SignIn" />@Localizer["SignIn"]
                            </a>
                        }
                    </div>

                    @* Three things a client can count on, each ticked in the success colour. Words a
                       reader reads, so a list rather than a picture; the ticks are the glyph's own
                       `aria-hidden`. *@
                    <ul class="dt-landing-ticks">
                        <li><Icon Name="IconName.Confirm" />@Localizer["LandingTickEmail"]</li>
                        <li><Icon Name="IconName.Confirm" />@Localizer["LandingTickProof"]</li>
                        <li><Icon Name="IconName.Confirm" />@Localizer["LandingTickPhone"]</li>
                    </ul>
                </div>

                @* The picture of the product - a map, a parcel on its way, its proof and the
                   client's own list - is its own component, kept apart from the page: it is drawn
                   in the artboard's colours rather than the palette's, and is decoration from end
                   to end. *@
                <LandingHeroScene />
            </div>
        </section>

        @* What a client gets, one card each for asking, knowing and proof. Each card opens on a
           picture of what it promises - the request form's addresses, the emails, the proof - drawn
           by its own illustration component in a panel the card bleeds to its edges, and its title
           carries the shared set's glyph: the create action for the request, the notifications log
           for the emails, the proof for the proof. *@
        <section class="dt-landing-section dt-landing-section--tint" id="features">
            <div class="dt-landing-wrap">
                <div class="dt-landing-head">
                    <span class="dt-landing-eyebrow">@Localizer["LandingNavFeatures"]</span>
                    <h2 class="dt-type-h1 dt-landing-h2">@Localizer["LandingFeaturesTitle"]</h2>
                    <p class="dt-landing-sub dt-muted">@Localizer["LandingFeaturesLead"]</p>
                </div>

                <div class="dt-landing-grid dt-landing-grid--3">
                    <article class="dt-card dt-landing-tile dt-landing-tile--pictured">
                        <div class="dt-landing-vis"><RequestIllustration /></div>
                        <div class="dt-landing-tile-text">
                            <h3 class="dt-type-h2 dt-landing-tile-title"><Icon Name="IconName.Create" />@Localizer["LandingFeatureRequest"]</h3>
                            <p class="dt-landing-tile-body dt-muted">@Localizer["LandingFeatureRequestBody"]</p>
                        </div>
                    </article>
                    <article class="dt-card dt-landing-tile dt-landing-tile--pictured">
                        <div class="dt-landing-vis"><UpdatesIllustration /></div>
                        <div class="dt-landing-tile-text">
                            <h3 class="dt-type-h2 dt-landing-tile-title"><Icon Name="IconName.Notifications" />@Localizer["LandingFeatureUpdates"]</h3>
                            <p class="dt-landing-tile-body dt-muted">@Localizer["LandingFeatureUpdatesBody"]</p>
                        </div>
                    </article>
                    <article class="dt-card dt-landing-tile dt-landing-tile--pictured">
                        <div class="dt-landing-vis"><ProofIllustration /></div>
                        <div class="dt-landing-tile-text">
                            <h3 class="dt-type-h2 dt-landing-tile-title"><Icon Name="IconName.Proof" />@Localizer["LandingFeatureProof"]</h3>
                            <p class="dt-landing-tile-body dt-muted">@Localizer["LandingFeatureProofBody"]</p>
                        </div>
                    </article>
                </div>
            </div>
        </section>

        <section class="dt-landing-section" id="how">
            <div class="dt-landing-wrap">
                <div class="dt-landing-head">
                    <span class="dt-landing-eyebrow">@Localizer["LandingNavHow"]</span>
                    <h2 class="dt-type-h1 dt-landing-h2">@Localizer["LandingHowTitle"]</h2>
                </div>

                @* An ordered list, so the numbers are the list's own: the figure in each disc is
                   drawn for the eye and hidden from a screen reader, which announces the position
                   itself. The discs are joined by a dashed line drawn by the list, and the last is
                   in the success colour - the step where the parcel has arrived. *@
                <ol class="dt-landing-grid dt-landing-grid--4 dt-landing-steps">
                    <li class="dt-landing-step">
                        <span class="dt-landing-step-no" aria-hidden="true">1</span>
                        <h3 class="dt-type-h2 dt-landing-tile-title">@Localizer["LandingStep1"]</h3>
                        <p class="dt-landing-tile-body dt-muted">@Localizer["LandingStep1Body"]</p>
                    </li>
                    <li class="dt-landing-step">
                        <span class="dt-landing-step-no" aria-hidden="true">2</span>
                        <h3 class="dt-type-h2 dt-landing-tile-title">@Localizer["LandingStep2"]</h3>
                        <p class="dt-landing-tile-body dt-muted">@Localizer["LandingStep2Body"]</p>
                    </li>
                    <li class="dt-landing-step">
                        <span class="dt-landing-step-no" aria-hidden="true">3</span>
                        <h3 class="dt-type-h2 dt-landing-tile-title">@Localizer["LandingStep3"]</h3>
                        <p class="dt-landing-tile-body dt-muted">@Localizer["LandingStep3Body"]</p>
                    </li>
                    <li class="dt-landing-step">
                        <span class="dt-landing-step-no dt-landing-step-no--done" aria-hidden="true">4</span>
                        <h3 class="dt-type-h2 dt-landing-tile-title">@Localizer["LandingStep4"]</h3>
                        <p class="dt-landing-tile-body dt-muted">@Localizer["LandingStep4Body"]</p>
                    </li>
                </ol>
            </div>
        </section>

        @* The questions as one column, with the client's list on a phone beside it - the last
           question is whether it works on one. *@
        <section class="dt-landing-section dt-landing-section--tint" id="faq">
            <div class="dt-landing-wrap dt-landing-faq-row">
                <div>
                    <div class="dt-landing-head">
                        <span class="dt-landing-eyebrow">@Localizer["LandingNavFaq"]</span>
                        <h2 class="dt-type-h1 dt-landing-h2">@Localizer["LandingFaqTitle"]</h2>
                    </div>

                    <div class="dt-landing-faq-list">
                        <div class="dt-card dt-landing-tile dt-landing-faq">
                            <h3 class="dt-type-h3 dt-landing-tile-title">@Localizer["LandingFaq1"]</h3>
                            <p class="dt-landing-tile-body dt-muted">@Localizer["LandingFaq1Answer"]</p>
                        </div>
                        <div class="dt-card dt-landing-tile dt-landing-faq">
                            <h3 class="dt-type-h3 dt-landing-tile-title">@Localizer["LandingFaq2"]</h3>
                            <p class="dt-landing-tile-body dt-muted">@Localizer["LandingFaq2Answer"]</p>
                        </div>
                        <div class="dt-card dt-landing-tile dt-landing-faq">
                            <h3 class="dt-type-h3 dt-landing-tile-title">@Localizer["LandingFaq3"]</h3>
                            <p class="dt-landing-tile-body dt-muted">@Localizer["LandingFaq3Answer"]</p>
                        </div>
                        <div class="dt-card dt-landing-tile dt-landing-faq">
                            <h3 class="dt-type-h3 dt-landing-tile-title">@Localizer["LandingFaq4"]</h3>
                            <p class="dt-landing-tile-body dt-muted">@Localizer["LandingFaq4Answer"]</p>
                        </div>
                    </div>
                </div>

                <PhoneDeliveries />
            </div>
        </section>

        @* The closing call to action exists to sign somebody up, so a caller who is already signed
           in is not shown it: the header and the hero have already offered them their way in. *@
        @if (!Caller.IsAuthenticated)
        {
            <section class="dt-landing-section dt-landing-dark dt-landing-cta">
                @* A route ending in a pin, drawn behind the words: the band's one picture. *@
                <RouteLine />
                <div class="dt-landing-wrap dt-landing-cta-row">
                    <div class="dt-landing-cta-text">
                        <h2 class="dt-type-h1 dt-landing-h2">@Localizer["LandingCtaTitle"]</h2>
                        <p class="dt-landing-sub">@Localizer["LandingCtaLead"]</p>
                    </div>
                    <div class="dt-landing-actions">
                        <a class="btn btn-primary" href="register">
                            <Icon Name="IconName.Register" />@Localizer["LandingCreateAccount"]
                        </a>
                        <a class="btn btn-outline-secondary" href="sign-in">
                            <Icon Name="IconName.SignIn" />@Localizer["SignIn"]
                        </a>
                    </div>
                </div>
            </section>
        }
    </main>

    @* Only links that go somewhere: the page's own sections and the way in. No company or legal
       pages and no contact details until real ones exist - a link to nowhere, or an address nobody
       answers, is worse than none. *@
    <footer class="dt-landing-dark dt-landing-foot">
        <div class="dt-landing-wrap">
            <div class="dt-landing-foot-grid">
                <div>
                    <a class="dt-landing-brand dt-landing-brand--inverse" href="#top">
                        <span class="dt-nav__mark dt-icon-only"><Icon Name="IconName.Location" /></span>DriveTrack
                    </a>
                    <p class="dt-landing-foot-text">@Localizer["LandingFootTagline"]</p>
                </div>

                <div>
                    <h2 class="dt-landing-foot-head">@Localizer["LandingFootSections"]</h2>
                    <ul class="dt-landing-foot-list">
                        <li><a href="#features">@Localizer["LandingNavFeatures"]</a></li>
                        <li><a href="#how">@Localizer["LandingNavHow"]</a></li>
                        <li><a href="#faq">@Localizer["LandingNavFaq"]</a></li>
                    </ul>
                </div>

                <div>
                    <h2 class="dt-landing-foot-head">@Localizer["LandingFootAccount"]</h2>
                    <ul class="dt-landing-foot-list">
                        @if (Caller.IsAuthenticated)
                        {
                            <li><a href="@LandingRoute.For(Caller.Role)">@WayInName</a></li>
                        }

                        @if (!Caller.IsAuthenticated)
                        {
                            <li><a href="sign-in">@Localizer["SignIn"]</a></li>
                            <li><a href="register">@Localizer["LandingCreateAccount"]</a></li>
                        }
                    </ul>
                </div>
            </div>

            <div class="dt-landing-foot-bar">
                <span>© 2026 DriveTrack</span>
                <span class="dt-landing-foot-spacer"></span>
                <DtLanguageSwitch ReturnUrl="/" Tone="DtLanguageTone.Dark" />
            </div>
        </div>
    </footer>
</div>

@code {
    // Where a role lands, for the label that names it. LandingRoute owns the address; this names
    // each place it can answer, and a new one fails loudly here rather than borrowing a label.
    private bool WayInIsDashboard => LandingRoute.For(Caller.Role) switch
    {
        "/dashboard" => true,
        "/profile" => false,
        var route => throw new InvalidOperationException(
            $"The landing page has no label for the landing route '{route}'."),
    };

    private UserProfile? _me;

    // The language being read, from the culture the request resolved to - DtLanguageSwitch's own
    // reading, for its reason: the cookie may hold a value the supported list refused.
    private static bool IsUkrainian =>
        string.Equals(
            System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName,
            "uk",
            StringComparison.Ordinal);

    // The language button names the current language by its own short code, as both catalogues do.
    private string CurrentLanguage =>
        IsUkrainian ? Localizer["LanguageUkrainian"] : Localizer["LanguageEnglish"];

    // The language button's name: what it is for, then the code it shows, so the visible text is
    // part of the name a voice user would say.
    private string LanguageButtonLabel => $"{Localizer["Language"]}: {CurrentLanguage}";

    // Named in words only when the name it would otherwise show could not be read.
    private string? AccountButtonLabel => _me is null ? Localizer["LandingAccountMenu"].Value : null;

    // `aria-current` on the language being read; absent, rather than "false", on the other.
    private static string? CurrentWhen(bool current) => current ? "true" : null;

    // The avatar's two letters: the first of each name, upper-cased in the culture being read.
    private string Initials => _me is null
        ? string.Empty
        : string.Concat(
            _me.FirstName.AsSpan(0, Math.Min(1, _me.FirstName.Length)),
            _me.LastName.AsSpan(0, Math.Min(1, _me.LastName.Length)))
            .ToUpper(System.Globalization.CultureInfo.CurrentCulture);

    // The one way into the application, as a button's content: the navigation's own glyph and word
    // for the place it goes to. The dashboard's glyph is the timeline, as it is in the menu.
    private RenderFragment WayIn => @<text>
        @if (WayInIsDashboard)
        {
            <Icon Name="IconName.Timeline" />@Localizer["NavDashboard"]
        }
        @if (!WayInIsDashboard)
        {
            <Icon Name="IconName.Profile" />@Localizer["Profile"]
        }
    </text>;

    // The same, as a footer link: words only, as every other link in that column is.
    private string WayInName => WayInIsDashboard ? Localizer["NavDashboard"] : Localizer["Profile"];

    protected override async Task OnInitializedAsync()
    {
        if (!Caller.IsAuthenticated)
        {
            return;
        }

        try
        {
            _me = await Users.GetProfileAsync(Caller.UserId, CircuitToken);
        }
        catch (DriveTrackException)
        {
            // The header draws without the name rather than failing the page.
            _me = null;
        }
    }
}
