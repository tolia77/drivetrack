@page "/deliveries"
@* FR-18 to FR-24, FR-101: the dispatch board.

   The Roles argument routes a wrong role to /access-denied (FR-79) rather than into an error
   boundary. It is a convenience, not the decision: IAccessGuard inside IDeliveryService settles
   whether this caller may run dispatch, and it runs whether or not this screen was ever rendered.

   Sorting and filtering happen on the server, over every delivery, a page at a time: a heading,
   a filter or the pager changes the view, the view is written into the address - so a reload, Back
   and a shared link all reproduce it - and the page that answers it is what the table draws.

   The @if blocks below are independent rather than if/else chains: an `else` at markup level reads
   to NFR-14's source scan as a rendered English word. *@
@attribute [Authorize(Roles = "Dispatcher,Admin")]
@* Named for what it does rather than for the capability: a member called `Deliveries` on a
   component called `Deliveries` does not compile. *@
@inject IDeliveryService Dispatch
@inject IDriverService DriverRoster
@inject IVehicleService VehicleFleet
@inject IClientAdministrationService ClientRoster
@inject ICurrentUser Caller
@inject IStringLocalizer<UiText> Localizer
@inherits PagedScreen<ListDeliveriesQuery, DeliverySummary, DeliverySort>

<PageTitle>@Localizer["DeliveriesTitle"]</PageTitle>

@* The screen's title and the one action that opens an empty form, on one line. The create action
   is about the collection rather than about any row in it, so it belongs beside the heading that
   names the collection - and the filters, which narrow that collection, belong in the panel below
   with the action that clears them rather than up here beside a create. *@
<div class="dt-page-head mb-4">
    <h1 class="dt-type-h1">
        <Icon Name="IconName.Deliveries" />@Localizer["DeliveriesTitle"]
    </h1>

    <button type="button" class="btn btn-primary dt-delivery-create" @onclick="OpenCreateAsync">
        <Icon Name="IconName.Create" />@Localizer["CreateDelivery"]
    </button>
</div>

@* FR-29 and FR-103 arrive here: a missing driver, a missing client and an overloaded vehicle each
   resolve through the same catalogue the REST envelope uses, so the two cannot disagree (NFR-3).
   None of the three names a field, so all three stay here; the form's own refusals are said under
   the boxes that produced them. *@
<DtFailureBanner Failures="_failures" InlineFields="@InlineFields" />

@* FR-20 and FR-101: every filter in one bounded panel rather than three loose rows floating on the
   page, and one action at the end of it that clears all ten. A per-field clear would leave a
   dispatcher hunting for the box still narrowing the list.

   A <form> rather than a <div>, so the group has a role and an accessible name: a screen reader
   announces the ten controls as the filters they are instead of as ten unrelated boxes between the
   heading and the table. Nothing is posted - every box is two-way bound and asks the server for page
   one of what it now matches as it is typed in - so the default submission is prevented rather than
   handled. *@
<form class="dt-card dt-filters mb-4" aria-label="@Localizer["Filters"]"
      @onsubmit="KeepFilters" @onsubmit:preventDefault>
    <div class="dt-filters-grid">
        <div>
            <label class="form-label" for="delivery-filter-driver">@Localizer["Driver"]</label>
            <input id="delivery-filter-driver" type="search" class="form-control"
                   @bind="_filter.Driver" @bind:event="oninput"
                   @bind:after="FilterTypedAsync" />
        </div>
        <div>
            <label class="form-label" for="delivery-filter-client">@Localizer["Client"]</label>
            <input id="delivery-filter-client" type="search" class="form-control"
                   @bind="_filter.Client" @bind:event="oninput"
                   @bind:after="FilterTypedAsync" />
        </div>
        <div>
            <label class="form-label" for="delivery-filter-pickup">@Localizer["Pickup"]</label>
            <input id="delivery-filter-pickup" type="search" class="form-control"
                   @bind="_filter.Pickup" @bind:event="oninput"
                   @bind:after="FilterTypedAsync" />
        </div>
        <div>
            <label class="form-label" for="delivery-filter-dropoff">@Localizer["Dropoff"]</label>
            <input id="delivery-filter-dropoff" type="search" class="form-control"
                   @bind="_filter.Dropoff" @bind:event="oninput"
                   @bind:after="FilterTypedAsync" />
        </div>
        <div>
            <label class="form-label" for="delivery-filter-details">@Localizer["PackageDetails"]</label>
            <input id="delivery-filter-details" type="search" class="form-control"
                   @bind="_filter.PackageDetails" @bind:event="oninput"
                   @bind:after="FilterTypedAsync" />
        </div>
        <div>
            <label class="form-label" for="delivery-filter-notes">@Localizer["DeliveryNotes"]</label>
            <input id="delivery-filter-notes" type="search" class="form-control"
                   @bind="_filter.DeliveryNotes" @bind:event="oninput"
                   @bind:after="FilterTypedAsync" />
        </div>
    </div>

    <div class="dt-filters-row">
        <div class="dt-filters-field">
            <label class="form-label" for="delivery-filter-status">@Localizer["Status"]</label>
            <DtSelect Id="delivery-filter-status" @bind-Value="_filter.Status" @bind-Value:after="FilterChosenAsync">
                <option value="">@Localizer["FilterAll"]</option>
                @* The value is the enum member rendered, not a literal beside it: AD-21 makes the
                   member name the wire form, and writing it out here would be a second copy to
                   keep in step. *@
                <option value="@DeliveryStatus.Pending">@Localizer["StatusPending"]</option>
                <option value="@DeliveryStatus.InTransit">@Localizer["StatusInTransit"]</option>
                <option value="@DeliveryStatus.Delivered">@Localizer["StatusDelivered"]</option>
                <option value="@DeliveryStatus.Failed">@Localizer["StatusFailed"]</option>
            </DtSelect>
        </div>
        <div class="dt-filters-field">
            <label class="form-label" for="delivery-filter-created-from">@Localizer["CreatedFrom"]</label>
            <input id="delivery-filter-created-from" type="date" class="form-control"
                   @bind="_filter.CreatedFrom" @bind:after="FilterChosenAsync" />
        </div>
        <div class="dt-filters-field">
            <label class="form-label" for="delivery-filter-created-to">@Localizer["CreatedTo"]</label>
            <input id="delivery-filter-created-to" type="date" class="form-control"
                   @bind="_filter.CreatedTo" @bind:after="FilterChosenAsync" />
        </div>

        @* The box and its word are one control, so the label wraps the input as well as pointing at
           it: the whole phrase is then the hit area, which on a phone is the difference between a
           checkbox a thumb can find and one it cannot. A native checkbox rather than the framework's
           restyled one, because the tick is painted with `accent-color` and an `appearance: none`
           control has no tick left to paint. *@
        <label class="dt-check" for="delivery-filter-overdue">
            <input id="delivery-filter-overdue" type="checkbox" @bind="_filter.OverdueOnly"
                   @bind:after="FilterChosenAsync" />
            @Localizer["OverdueOnly"]
        </label>

        @* The panel's own reset and the empty table's are the same action and deliberately not the
           same hook: they say the same words, so a test that could not tell them apart would pass
           on a board that offers the way out of an empty filtered list to a board with rows in it
           and never offers it where it is needed. *@
        <button type="button" class="btn btn-outline-secondary ms-auto dt-delivery-filters-reset"
                @onclick="ResetFilters">
            <Icon Name="IconName.Close" />@Localizer["ResetFilters"]
        </button>
    </div>
</form>

@* NFR-27: one page of the board at a time, filtered and sorted by the server over every delivery,
   with the pager under the table saying how many matched and how far through them the page is. *@
@* `dt-table-cards` is where this screen opts into the shared collapse: below the phone breakpoint
   the table's rows stop being rows and become cards. Ten columns is the widest table in the
   product and the one that needed it most - until this wrapper the board was a horizontal
   scroller on a handset, a dispatcher dragging a row sideways to find out what was in it.

   The collapse is stated once, in `_theme.scss`, so nothing about it is written here or in
   `Deliveries.razor.css` - and because it is a global rule rather than a scoped one, none of it
   needs a `::deep`. What the wrapper's own name is for is the per-cell labels: the rule that
   reveals them hangs off `.dt-deliveries`, and the phone-layout suite reads it as the element the
   table has to be inside. *@
<div class="dt-deliveries dt-table-cards">
    <DtDataTable TItem="DeliverySummary"
                 Page="Listed"
                 OnPage="GoToPageAsync"
                 OnPageSize="ResizeAsync"
                 CountOne="@Localizer["DeliveriesCountOne"]"
                 CountMany="@Localizer["DeliveriesCountMany"]"
                 IsLoading="Loading"
                 EmptyText="@Localizer["DeliveriesEmpty"]">
        @* The way out of an empty list, under the sentence that says it is empty - and only when there
           is a way out to offer. An empty board has two causes: filters that match no delivery, and a
           board with nothing on it at all. Clearing helps with the first and does nothing
           at all about the second, so the action is offered only when something is actually set to be
           cleared; an unfiltered empty board says it is empty and stops there. *@
        <EmptyAction>
            @if (IsFiltered)
            {
                <button type="button" class="btn btn-outline-secondary btn-sm dt-delivery-empty-reset"
                        @onclick="ResetFilters">
                    <Icon Name="IconName.Close" />@Localizer["ResetFilters"]
                </button>
            }
        </EmptyAction>
        <HeaderTemplate>
            @* DtDataTable carries no sorting of its own - it renders whatever rows it is given - so the
               sort controls belong to the consumer, and a heading is the control. Pressing one asks the
               server for page one in the new order; the ordering itself is the repository's. The handlers are
               built in code rather than written as lambdas here: a `=>` inside an attribute closes the
               tag as far as a source scan is concerned.

               aria-sort is what makes the reordering perceivable at all to a screen reader: without it
               the rows silently rearrange and nothing says which column did it or in which direction.
               Its three values are ARIA tokens rather than prose - a browser reads them out in the
               user's own language - so they take no resource key, and they are computed in a method
               for the same reason the handlers are.

               The glyph is the sighted half of the same fact. Every heading carries the stacked pair
               that means "this sorts"; the one the rows are actually in order by swaps it for a single
               chevron pointing the way it went, so ascending and descending differ by shape rather than
               by the brand colour alone. Chosen in a method keyed on the column, exactly as the ARIA
               state is - a method call is legal in an attribute value, and the two alternatives are the
               `=>` and the call inside an @@if that the Razor idioms here forbid. *@
            <th scope="col" aria-sort="@SortState(DeliverySort.Window)">
                <button type="button" class="btn btn-link btn-sm" @onclick="SortHandler(DeliverySort.Window)">
                    @Localizer["DeliveryWindow"]<Icon Name="@SortGlyph(DeliverySort.Window)" />
                </button>
            </th>
            <th scope="col" aria-sort="@SortState(DeliverySort.Driver)">
                <button type="button" class="btn btn-link btn-sm" @onclick="SortHandler(DeliverySort.Driver)">
                    @Localizer["Driver"]<Icon Name="@SortGlyph(DeliverySort.Driver)" />
                </button>
            </th>
            <th scope="col" aria-sort="@SortState(DeliverySort.Client)">
                <button type="button" class="btn btn-link btn-sm" @onclick="SortHandler(DeliverySort.Client)">
                    @Localizer["Client"]<Icon Name="@SortGlyph(DeliverySort.Client)" />
                </button>
            </th>
            <th scope="col" aria-sort="@SortState(DeliverySort.Pickup)">
                <button type="button" class="btn btn-link btn-sm" @onclick="SortHandler(DeliverySort.Pickup)">
                    @Localizer["Pickup"]<Icon Name="@SortGlyph(DeliverySort.Pickup)" />
                </button>
            </th>
            <th scope="col" aria-sort="@SortState(DeliverySort.Dropoff)">
                <button type="button" class="btn btn-link btn-sm" @onclick="SortHandler(DeliverySort.Dropoff)">
                    @Localizer["Dropoff"]<Icon Name="@SortGlyph(DeliverySort.Dropoff)" />
                </button>
            </th>
            <th scope="col" aria-sort="@SortState(DeliverySort.PackageDetails)">
                <button type="button" class="btn btn-link btn-sm" @onclick="SortHandler(DeliverySort.PackageDetails)">
                    @Localizer["PackageDetails"]<Icon Name="@SortGlyph(DeliverySort.PackageDetails)" />
                </button>
            </th>
            <th scope="col" aria-sort="@SortState(DeliverySort.DeliveryNotes)">
                <button type="button" class="btn btn-link btn-sm" @onclick="SortHandler(DeliverySort.DeliveryNotes)">
                    @Localizer["DeliveryNotes"]<Icon Name="@SortGlyph(DeliverySort.DeliveryNotes)" />
                </button>
            </th>
            <th scope="col" aria-sort="@SortState(DeliverySort.Status)">
                <button type="button" class="btn btn-link btn-sm" @onclick="SortHandler(DeliverySort.Status)">
                    @Localizer["Status"]<Icon Name="@SortGlyph(DeliverySort.Status)" />
                </button>
            </th>
            <th scope="col" aria-sort="@SortState(DeliverySort.CreatedAt)">
                <button type="button" class="btn btn-link btn-sm" @onclick="SortHandler(DeliverySort.CreatedAt)">
                    @Localizer["CreatedAt"]<Icon Name="@SortGlyph(DeliverySort.CreatedAt)" />
                </button>
            </th>
            @* The actions column keeps its heading for a screen reader and drops it on screen: the
               buttons under it say what they do, and a column named twice is a column name competing
               with them. The cell itself stays, so the column keeps its width for a role with no
               actions in it. *@
            <th scope="col" class="dt-table-actions">
                <span class="dt-visually-hidden">@Localizer["Actions"]</span>
            </th>
        </HeaderTemplate>
        <RowTemplate Context="delivery">
            @* FR-19 and FR-100: the window the delivery was promised in, and - when the clock has passed
               its far bound - the badge saying so, inside this cell rather than in a column of its own.
               Overdue is derived from the window, so a column apart from it would have been the same
               fact twice with a gap between them; beside the hours it is a mark on the value it is
               about. Routed through a method rather than formatted in markup: NFR-14's scan strips a
               Razor expression only up to its first closing bracket, so a `.ToString(...)` tail would be
               left behind in the text node and read as a rendered English word. *@
            <td class="dt-table-window">
                @* The per-cell name, carried by the cell rather than only by the column heading.
                   Above the breakpoint it is dropped - the `<th>` already names the column, and a
                   second name in every cell would be that name read twice a row. Below it the head
                   is gone and this is what replaces it, painted by `Deliveries.razor.css`. *@
                <span class="dt-visually-hidden dt-delivery-label">@Localizer["DeliveryWindow"]</span>
                @* A window with both bounds is a range and says so with the dash between them. A window
                   with one bound is a direction - "from" or "until" - because a range with a hole where
                   a bound should be says nothing about which end is missing, and a dash standing in for
                   an absent figure beside a dash meaning "to" reads as neither. The word is rendered
                   here rather than composed in the method because the catalogue is closed against the
                   keys asked for in markup, and a key resolved only from code is a key no test sees. *@
                @if (delivery.WindowEarliestAt is not null && delivery.WindowLatestAt is null)
                {
                    <span>@Localizer["WindowFrom"]</span>
                }
                @if (delivery.WindowEarliestAt is null && delivery.WindowLatestAt is not null)
                {
                    <span>@Localizer["WindowUntil"]</span>
                }
                @Window(delivery)
                @if (delivery.IsOverdue)
                {
                    <DtBadge Variant="DtBadgeVariant.Overdue">@Localizer["Overdue"]</DtBadge>
                }
            </td>
            <td>
                <span class="dt-visually-hidden dt-delivery-label">@Localizer["Driver"]</span>
                @if (delivery.Driver is null)
                {
                    <span class="dt-muted">@Localizer["NoDriver"]</span>
                }
                @if (delivery.Driver is not null)
                {
                    <span>@delivery.Driver.Name</span>
                }
            </td>
            <td>
                <span class="dt-visually-hidden dt-delivery-label">@Localizer["Client"]</span>
                @if (delivery.Client is null)
                {
                    <span class="dt-muted">@Localizer["NoClient"]</span>
                }
                @if (delivery.Client is not null)
                {
                    <span>@delivery.Client.Name</span>
                }
            </td>
            @* FR-21: the cell is the way to the map. The label is the address when one has been
               resolved and the coordinates when none has (FR-94), so the cell is never empty.

               The design draws these two as plain text with a single Map action in the row, and that is
               the one place this screen departs from it: one button cannot mean two places. DtMap takes
               a single point and carries no marker collection, so a row-level Map would have to pick a
               side or grow a component the two form pickers also render. Two cells, two points, two
               ways in. *@
            <td class="dt-delivery-place">
                <span class="dt-visually-hidden dt-delivery-label">@Localizer["Pickup"]</span>
                <button type="button" class="btn btn-link btn-sm dt-delivery-pickup"
                        @onclick="ShowLocationHandler(delivery.Pickup)">
                    <Icon Name="IconName.Location" />@LocationText.Describe(delivery.Pickup)
                </button>
            </td>
            <td class="dt-delivery-place">
                <span class="dt-visually-hidden dt-delivery-label">@Localizer["Dropoff"]</span>
                <button type="button" class="btn btn-link btn-sm dt-delivery-dropoff"
                        @onclick="ShowLocationHandler(delivery.Dropoff)">
                    <Icon Name="IconName.Location" />@LocationText.Describe(delivery.Dropoff)
                </button>
            </td>
            <td>
                <span class="dt-visually-hidden dt-delivery-label">@Localizer["PackageDetails"]</span>
                @delivery.PackageDetails
            </td>
            @* The client's instructions, and the one cell on the row that is often empty. The
               cell's own name goes inside the block with the value it names: a delivery with no
               note would otherwise show a heading on a card with nothing under it, which is worse
               than a card with one line fewer. *@
            <td class="dt-muted">
                @if (!string.IsNullOrWhiteSpace(delivery.DeliveryNotes))
                {
                    <span class="dt-visually-hidden dt-delivery-label">@Localizer["DeliveryNotes"]</span>
                    @delivery.DeliveryNotes
                }
            </td>
            @* One status vocabulary, shared with the own-deliveries screen and with every timeline
               entry. The filter's <option> list above keeps its own literal keys, because those are
               values as much as labels. *@
            <td>
                <span class="dt-visually-hidden dt-delivery-label">@Localizer["Status"]</span>
                <DeliveryStatusLabel Status="delivery.Status" />
            </td>
            @* Routed through a method for the reason the window is. *@
            <td class="dt-muted">
                <span class="dt-visually-hidden dt-delivery-label">@Localizer["CreatedAt"]</span>
                @Created(delivery)
            </td>
            <td class="dt-table-actions">
                @* The per-cell name the other nine cells carry. The buttons under it name
                   themselves, which is why the column's heading is hidden even on a desktop - but
                   below the breakpoint the head is dropped outright, so without this the group of
                   actions would be the one part of a card that announces nothing at all. *@
                <span class="dt-visually-hidden dt-delivery-label">@Localizer["Actions"]</span>
                @* FR-108: the history is a row action rather than a column, because it is a
                   conversation about one delivery and not a value to be compared across the table. *@
                <button type="button" class="btn btn-outline-secondary btn-sm dt-delivery-timeline"
                        @onclick="TimelineHandler(delivery)">
                    <Icon Name="IconName.Timeline" />@Localizer["Timeline"]
                </button>
                @* FR-122: dispatch reads the evidence, and is one of the two roles told who captured it
                   (AD-17). There is no capture action here - FR-119 puts that at the door, and a
                   dispatcher behind a desk has nothing to photograph; the note arm of FR-120 is what
                   dispatch has instead, and it lives on the history panel beside this button. *@
                <button type="button" class="btn btn-outline-secondary btn-sm dt-proof-open"
                        @onclick="ProofHandler(delivery)">
                    <Icon Name="IconName.Proof" />@Localizer["ProofOpen"]
                </button>
                @* Last of the three the design draws, and the only one of them that changes anything:
                   the neutral reads come first and the edit colour closes the row. *@
                <button type="button" class="btn btn-secondary btn-sm dt-delivery-edit"
                        @onclick="EditHandler(delivery)">
                    <Icon Name="IconName.Edit" />@Localizer["Edit"]
                </button>
                @* FR-24 reserves deletion to an administrator, and the service refuses a dispatcher who
                   asks. Offering an action that could only ever fail is worse than not offering it.
                   FR-12 unchanged: this hides, IAccessGuard decides. *@
                @if (_isAdmin)
                {
                    <button type="button" class="btn btn-danger btn-sm dt-delivery-delete"
                            @onclick="DeleteHandler(delivery)">
                        <Icon Name="IconName.Delete" />@Localizer["Delete"]
                    </button>
                }
            </td>
        </RowTemplate>
    </DtDataTable>
</div>

@* FR-85: the shared dialog. One heading for both create and edit - a title composed at run time
   would be a key no test can see, and the catalogue is closed against the keys components ask for. *@
<DtDialog @ref="_formDialog" Title="@Localizer["DeliveryForm"]" OnClosed="ClearFailures" Wide="true">
    <ChildContent>
        @* A second copy of the banner, deliberately. A DtDialog opens with showModal(), so
           everything outside it is inert behind the backdrop: a refusal rendered only at page level
           is a form that fails to close and says nothing. *@
        <DtFailureBanner Failures="_failures" InlineFields="@InlineFields" />

        @* FR-15 and FR-104: a point is set by clicking the map, or by searching for an address and
           choosing one of the answers. Both end at the same assignment - the chosen match writes the
           same MapLocation a click writes - so the two are one input with two ways in rather than
           two fields that could disagree. DtLocationPicker is that column, and this screen renders
           two of the four in the product; what it hands over is the stem its hooks are built from,
           the box the form owns, the point that box fills and the sink its field message reads.

           These two blocks sit OUTSIDE <EditForm>, and that is the point rather than an accident of
           ordering. An <input> inside a form whose default button is the dialog's Save button makes
           Enter an implicit submit: the most natural gesture in a search box would save the delivery
           instead of searching. Blazor's `@@onkeydown:preventDefault` is evaluated once per render
           and cannot be made conditional on the key, so preventing the default here would also
           prevent the characters being typed. Taking the two boxes out of the form removes the
           default instead of fighting it - neither carries an Input* component, so the EditContext
           loses nothing - and Enter is then free to mean what it should.

           The two are columns of one row rather than one above the other: a pickup and a dropoff
           are read together - the whole question is where this goes from and to - and stacking two
           half-screen maps put the second one below the fold. They fall back to full width under
           `lg`, where side-by-side maps would be too narrow to aim at, and the dialog asks for the
           wide panel so the desktop pair has room. *@
        <div class="row g-4 mb-4">
            <div class="col-lg-6">
                <DtLocationPicker Prefix="pickup"
                                  Label="@Localizer["Pickup"]"
                                  Field="Pickup"
                                  Search="_form.PickupSearch"
                                  Value="_form.Pickup"
                                  ValueChanged="PickPickup"
                                  Failures="_failures" />
            </div>
            <div class="col-lg-6">
                <DtLocationPicker Prefix="dropoff"
                                  Label="@Localizer["Dropoff"]"
                                  Field="Dropoff"
                                  Search="_form.DropoffSearch"
                                  Value="_form.Dropoff"
                                  ValueChanged="PickDropoff"
                                  Failures="_failures" />
            </div>
        </div>

        <EditForm id="delivery-form" Model="_form" OnValidSubmit="SaveAsync">
            @* Clearing a number or a date field leaves a parse failure on the EditContext, and
               OnValidSubmit then never fires - so without this the Save button would do nothing and
               say nothing. ValidationSummary rather than per-field ValidationMessage: a
               `For="@(() => ...)"` lambda inside an attribute is what NFR-14's scan misreads. *@
            <ValidationSummary />

            @* FR-16: both are optional, and the empty choice is how a dispatcher says so - on an
               edit it is also how they unassign, which AD-23 carries as a present null. The two are
               one question - who carries this, and for whom - so they are one row of two columns
               that stacks when the panel is too narrow to hold both. *@
            <div class="dt-cols mb-4">
                <div>
                    <label class="form-label" for="delivery-driver">@Localizer["Driver"]</label>
                    <DtSelect Id="delivery-driver" @bind-Value="_form.DriverId">
                        <option value="">@Localizer["NoDriver"]</option>
                        @* FR-98: the standing travels with the name, because this is the moment a
                           dispatcher chooses who carries a parcel. Built in C# rather than as three
                           markup branches inside an <option>, which may only hold text. *@
                        @foreach (var driver in _drivers)
                        {
                            <option value="@driver.Id.Value">@DriverOption(driver)</option>
                        }
                    </DtSelect>
                </div>
                <div>
                    <label class="form-label" for="delivery-client">@Localizer["Client"]</label>
                    <DtSelect Id="delivery-client" @bind-Value="_form.ClientId">
                        <option value="">@Localizer["NoClient"]</option>
                        @foreach (var client in _clients)
                        {
                            <option value="@client.ClientId.Value">@client.FirstName @client.LastName</option>
                        }
                    </DtSelect>
                </div>
            </div>

            @* What is being moved and how heavy it is: one question again, and the capacity hint
               under the weight is about the pair rather than about the number alone. *@
            <div class="dt-cols mb-4">
                <div>
                    <label class="form-label" for="delivery-details">@Localizer["PackageDetails"]</label>
                    <InputText id="delivery-details" class="form-control" @bind-Value="_form.PackageDetails" />
                    <DtFieldError Field="PackageDetails" Failures="_failures" />
                </div>
                <div>
                    <label class="form-label" for="delivery-weight">@Localizer["PackageWeightKg"]</label>
                    @* No {0} in the message: the framework fills it with the CLR property name, which
                       would put a Latin word in front of a user (NFR-14). *@
                    <InputNumber id="delivery-weight" class="form-control"
                                 ParsingErrorMessage="@Localizer["NumberParseError"]"
                                 @bind-Value="_form.PackageWeightKg" />
                    @* FR-103's second figure. NFR-3 gives one wire message per code, so the refusal
                       itself cannot name the numbers - this is where the dispatcher sees the one they
                       are about to exceed, at the moment they could exceed it. *@
                    <DtFieldError Field="PackageWeightKg" Failures="_failures" />
                    <div class="form-text">@Localizer["VehicleCapacityHint"] @CapacityText</div>
                </div>
            </div>

            @* FR-100: either bound may stand alone and both may be absent; only an inverted pair is
               refused, by the validator and by the check constraint behind it. Side by side, because
               that is the only arrangement in which an inverted pair is visible as one. *@
            <div class="dt-cols mb-4">
                <div>
                    <label class="form-label" for="delivery-window-earliest">@Localizer["WindowEarliestAt"]</label>
                    <InputDate id="delivery-window-earliest" class="form-control"
                               Type="InputDateType.DateTimeLocal"
                               ParsingErrorMessage="@Localizer["DateParseError"]"
                               @bind-Value="_form.WindowEarliestAt" />
                </div>
                <div>
                    <label class="form-label" for="delivery-window-latest">@Localizer["WindowLatestAt"]</label>
                    <InputDate id="delivery-window-latest" class="form-control"
                               Type="InputDateType.DateTimeLocal"
                               ParsingErrorMessage="@Localizer["DateParseError"]"
                               @bind-Value="_form.WindowLatestAt" />
                    <DtFieldError Field="WindowLatestAt" Failures="_failures" />
                </div>
            </div>

            @* Free text about the whole delivery, so it runs the width of the panel under the fields
               it qualifies. *@
            <div class="mb-4">
                <label class="form-label" for="delivery-notes">@Localizer["DeliveryNotes"]</label>
                <InputTextArea id="delivery-notes" class="form-control" @bind-Value="_form.DeliveryNotes" />
                <DtFieldError Field="DeliveryNotes" Failures="_failures" />
            </div>
        </EditForm>
    </ChildContent>
    <Actions>
        @* Disabled while a save is in flight: the circuit yields at the await, so a second click
           would dispatch a second write, and nothing downstream would recognise it as a repeat. *@
        <button type="submit" form="delivery-form" class="dt-delivery-save @SaveVariant" disabled="@_saving">
            <Icon Name="@SaveGlyph" />@Localizer["Save"]
        </button>
        <button type="button" class="btn btn-outline-secondary" @onclick="CloseFormAsync">
            <Icon Name="IconName.Close" />@Localizer["Cancel"]
        </button>
    </Actions>
</DtDialog>

@* FR-21: the same map component, with picking off. One map, two jobs (NFR-26). *@
<DtDialog @ref="_mapDialog" Title="@Localizer["LocationTitle"]">
    <ChildContent>
        @if (_viewed is not null)
        {
            <DtMap Value="_viewed" Picker="false" />
        }
    </ChildContent>
</DtDialog>

@* FR-105 to FR-108: the delivery's history, and the two things dispatch may append to it. The panel
   is built only once a row has been chosen, so the screen costs no timeline read until somebody
   asks for one.

   The panel owns its dialog and opens itself on its first render; OnClosed drops the row, which
   disposes it. That is what makes each open a fresh read: the panel caches the entries and the
   status it computes its select from, and a panel left alive would offer moves from where the
   delivery was when it was last opened, with the last comment still in the box.

   AllowStatusChange is true for every caller who reaches this screen: the Roles attribute already
   narrowed them to dispatch, and RequireAssignedDriver is what actually decides (FR-12, FR-34). *@
@if (_timeline is not null)
{
    <DeliveryTimeline DeliveryId="_timeline.Id"
                      Status="_timeline.Status"
                      AllowStatusChange="true"
                      OnChanged="LoadAsync"
                      OnClosed="CloseTimeline" />
}

@* FR-122. Built only once a row has been chosen, for the reason the history panel is: the board
   costs no proof read until somebody asks for one, and dropping the row on close makes each open a
   fresh read rather than a panel holding whatever the last row had. *@
<DtDialog @ref="_proofDialog" Title="@Localizer["ProofViewTitle"]" OnClosed="CloseProof">
    <ChildContent>
        @if (_proof is not null)
        {
            <ProofView DeliveryId="_proof.Id" />
        }
    </ChildContent>
</DtDialog>

@* FR-81: a destructive action is confirmed through the shared prompt, and only where it could
   succeed. *@
@if (_isAdmin)
{
    <DtConfirmDialog @ref="_deleteDialog"
                     Title="@Localizer["DeleteDeliveryTitle"]"
                     Message="@Localizer["DeleteDeliveryMessage"]"
                     OnConfirmed="ConfirmDeleteAsync" />
}

@code {

    /// <summary>
    /// Drops the refusals when the form is dismissed, however it was dismissed.
    /// <para>
    /// FR-83. A refusal claimed by a box inside the dialog is subtracted from the banner outside it,
    /// so leaving the list populated past the close would leave that sentence with nowhere on the
    /// page to render - invisible, which is the outcome this whole change exists to prevent.
    /// Hung off <c>OnClosed</c> rather than off the cancel handler because Escape and the backdrop
    /// dismiss the dialog too, and the component routes all three through one event.
    /// </para>
    /// </summary>
    private void ClearFailures() => _failures = [];
    /// <summary>
    /// The boxes this screen renders a <c>DtFieldError</c> for. Stated once and bound by every
    /// banner on the page: the list repeated per banner is exactly the drift FR-83 is broken by,
    /// and a screen carries the banner more than once because a dialog opened with showModal()
    /// leaves the page behind it inert.
    /// </summary>
    private const string InlineFields = "Pickup,Dropoff,PackageDetails,PackageWeightKg,DeliveryNotes,WindowLatestAt";

    private DeliveryFilter _filter = new();

    // The filter panel's address names. Short, because they are what a shared link carries.
    private const string DriverName = "driver";
    private const string ClientName = "client";
    private const string PickupName = "pickup";
    private const string DropoffName = "dropoff";
    private const string DetailsName = "details";
    private const string NotesName = "notes";
    private const string StatusName = "status";
    private const string FromName = "from";
    private const string ToName = "to";
    private const string OverdueName = "overdue";

    /// <summary>The driver filter, as the address carries it.</summary>
    [SupplyParameterFromQuery(Name = DriverName)]
    public string? DriverParameter { get; set; }

    /// <summary>The client filter, as the address carries it.</summary>
    [SupplyParameterFromQuery(Name = ClientName)]
    public string? ClientParameter { get; set; }

    /// <summary>The pickup filter, as the address carries it.</summary>
    [SupplyParameterFromQuery(Name = PickupName)]
    public string? PickupParameter { get; set; }

    /// <summary>The dropoff filter, as the address carries it.</summary>
    [SupplyParameterFromQuery(Name = DropoffName)]
    public string? DropoffParameter { get; set; }

    /// <summary>The package details filter, as the address carries it.</summary>
    [SupplyParameterFromQuery(Name = DetailsName)]
    public string? DetailsParameter { get; set; }

    /// <summary>The notes filter, as the address carries it.</summary>
    [SupplyParameterFromQuery(Name = NotesName)]
    public string? NotesParameter { get; set; }

    /// <summary>The status filter, by member name, as the address carries it.</summary>
    [SupplyParameterFromQuery(Name = StatusName)]
    public string? StatusParameter { get; set; }

    /// <summary>The first creation day, ISO form, as the address carries it.</summary>
    [SupplyParameterFromQuery(Name = FromName)]
    public string? FromParameter { get; set; }

    /// <summary>The last creation day, ISO form, as the address carries it.</summary>
    [SupplyParameterFromQuery(Name = ToName)]
    public string? ToParameter { get; set; }

    /// <summary>The overdue switch, as the address carries it.</summary>
    [SupplyParameterFromQuery(Name = OverdueName)]
    public string? OverdueParameter { get; set; }

    private IReadOnlyList<DriverSummary> _drivers = [];
    private IReadOnlyList<ClientAccount> _clients = [];
    private IReadOnlyList<VehicleSummary> _vehicles = [];
    /// <summary>
    /// Why the last save or delete was refused. Not the address boxes' — each of those keeps its
    /// own (DW-41), so a search that succeeds cannot clear a refusal still on screen.
    /// </summary>
    private IReadOnlyList<ScreenFailure> _failures = [];

    /// <summary>
    /// The save action's variant, which follows the mode the dialog is in: creating a record is a
    /// create action and takes the create colour, and changing one that already exists is an edit.
    /// <para>
    /// One dialog serves both modes, so the button is the only thing on screen that can say which
    /// one the reader is in - and AD-28 gives the two actions different colours precisely so that
    /// it does. Resolved here rather than as a ternary in the attribute, for the reason
    /// <c>DtDialog</c> resolves its panel class into a property.
    /// </para>
    /// <para>
    /// Only the variant: the hook stays written out on the button itself, so the source still shows
    /// which control this is - and it is the hook a test names, because asserting the mode by the
    /// variant would be a test that passes the day somebody paints a delete button teal.
    /// </para>
    /// </summary>
    private string SaveVariant => _form.Id is null
        ? "btn btn-primary"
        : "btn btn-secondary";

    /// <summary>
    /// The glyph beside it, following the same mode: the create mark when the dialog is making a
    /// record and the confirm mark when it is saving changes to one. The icon and the colour move
    /// together, because colour is never allowed to be the only signal.
    /// </summary>
    private IconName SaveGlyph => _form.Id is null ? IconName.Create : IconName.Confirm;

    private DeliveryForm _form = new();
    private DeliverySummary? _pendingDeletion;
    private MapLocation? _viewed;

    /// <summary>The row whose history is open, or null while none is.</summary>
    private DeliverySummary? _timeline;

    /// <summary>The row whose proof is open, or null while none is.</summary>
    private DeliverySummary? _proof;

    private DtDialog? _formDialog;
    private DtDialog? _mapDialog;
    private DtDialog? _proofDialog;
    private DtConfirmDialog? _deleteDialog;

    private bool _isAdmin;

    /// <summary>
    /// True while a save is in flight, which is what disables the submit button for as long as it
    /// lasts. Nothing downstream deduplicates a repeated create — a delivery carries no licence
    /// plate the way a vehicle does — so a second click would simply be a second delivery.
    /// </summary>
    private bool _saving;

    /// <summary>
    /// The capacity of the vehicle the selected driver holds, or null when there is no driver or
    /// they hold nothing — which is the case FR-38 makes legal and FR-103 leaves unchecked.
    /// </summary>
    private decimal? SelectedCapacityKg => CapacityOf(_drivers, _vehicles, _form.DriverId);

    /// <summary>
    /// The capacity of the vehicle a driver holds, or null when no driver is named, the named
    /// driver is not on the page, or they hold nothing.
    /// </summary>
    /// <remarks>
    /// Internal and static so it can be tested directly: static rendering
    /// dispatches no events, so no render test can select a driver, and the number this hint exists
    /// to show would otherwise be asserted nowhere at all.
    /// </remarks>
    /// <param name="drivers">The drivers the form offers.</param>
    /// <param name="vehicles">The fleet the page fetched, which is where a capacity is read from.</param>
    /// <param name="driverId">The driver the form has selected, or null while none is.</param>
    internal static decimal? CapacityOf(
        IReadOnlyList<DriverSummary> drivers,
        IReadOnlyList<VehicleSummary> vehicles,
        int? driverId)
    {
        ArgumentNullException.ThrowIfNull(drivers);
        ArgumentNullException.ThrowIfNull(vehicles);

        var driver = drivers.FirstOrDefault(candidate => candidate.Id.Value == driverId);

        if (driver?.VehicleId is not { } vehicleId)
        {
            return null;
        }

        return vehicles.FirstOrDefault(vehicle => vehicle.Id == vehicleId)?.CapacityKg;
    }

    /// <summary>The capacity as the hint renders it, or a dash when there is none to show.</summary>
    private string CapacityText => SelectedCapacityKg is { } capacity
        ? capacity.ToString("N0", System.Globalization.CultureInfo.CurrentCulture)
        : CellText.NoValue;

    protected override async Task OnInitializedAsync()
    {
        // The circuit outlives the request that opened it, so the cookie can be gone by the time a
        // screen calls a service. Raising the contract's own code here is what puts that case
        // through FR-13's single boundary instead of a per-screen redirect.
        if (!Caller.IsAuthenticated)
        {
            throw new ForbiddenException(
                ErrorCode.AUTH_UNAUTHENTICATED,
                "The circuit has no authenticated caller: the session cookie is gone.");
        }

        // Read once, after the authenticated check: ICurrentUser.Role throws for an anonymous
        // caller, so asking outside that branch would take the screen down instead of refusing it.
        _isAdmin = Caller.Role == UserRole.Admin;

        await LoadPickersAsync();

        await base.OnInitializedAsync();
    }

    /// <summary>The board opens on the column the design leads with: a dispatcher's question is what is due next.</summary>
    protected override DeliverySort DefaultSort => DeliverySort.Window;

    /// <inheritdoc />
    protected override IReadOnlyCollection<DeliverySort> Sortable { get; } = Enum.GetValues<DeliverySort>();

    /// <inheritdoc />
    protected override ListDeliveriesQuery Compose(int offset, int limit, DeliverySort sort, bool descending) =>
        new(
            offset,
            limit,
            sort.ToString(),
            descending,
            TableQuery.Text(DriverParameter),
            TableQuery.Text(ClientParameter),
            TableQuery.Text(PickupParameter),
            TableQuery.Text(DropoffParameter),
            TableQuery.Text(DetailsParameter),
            TableQuery.Text(NotesParameter),
            TableQuery.Member<DeliveryStatus>(StatusParameter),
            TableQuery.Date(FromParameter),
            TableQuery.Date(ToParameter),
            TableQuery.Flag(OverdueParameter));

    /// <inheritdoc />
    protected override (int Offset, int Limit, DeliverySort Sort, bool Descending) Paging(ListDeliveriesQuery view) =>
        (view.Offset, view.Limit, ListSort.Parse<DeliverySort>(view.Sort) ?? DefaultSort, view.Descending);

    /// <inheritdoc />
    protected override ListDeliveriesQuery Repaged(
        ListDeliveriesQuery view,
        int offset,
        int limit,
        DeliverySort sort,
        bool descending) =>
        view with { Offset = offset, Limit = limit, Sort = sort.ToString(), Descending = descending };

    /// <inheritdoc />
    protected override void AddFilters(ListDeliveriesQuery view, IDictionary<string, object?> address)
    {
        address[DriverName] = view.Driver;
        address[ClientName] = view.Client;
        address[PickupName] = view.Pickup;
        address[DropoffName] = view.Dropoff;
        address[DetailsName] = view.PackageDetails;
        address[NotesName] = view.DeliveryNotes;
        address[StatusName] = view.Status?.ToString();
        address[FromName] = TableQuery.DateValue(view.CreatedFrom);
        address[ToName] = TableQuery.DateValue(view.CreatedTo);
        address[OverdueName] = TableQuery.FlagValue(view.OverdueOnly);
    }

    /// <inheritdoc />
    protected override void Adopt(ListDeliveriesQuery view) =>
        _filter = new DeliveryFilter
        {
            Driver = view.Driver,
            Client = view.Client,
            Pickup = view.Pickup,
            Dropoff = view.Dropoff,
            PackageDetails = view.PackageDetails,
            DeliveryNotes = view.DeliveryNotes,
            Status = view.Status,
            CreatedFrom = view.CreatedFrom,
            CreatedTo = view.CreatedTo,
            OverdueOnly = view.OverdueOnly,
        };

    /// <inheritdoc />
    protected override async Task<Paged<DeliverySummary>?> FetchAsync(ListDeliveriesQuery view) =>
        await Dispatch.ListAsync(view, CircuitToken);

    /// <summary>The view the filter panel describes, at page one: a new filter is a new list.</summary>
    private ListDeliveriesQuery Filtered() =>
        FirstPage(View) with
        {
            Driver = TableQuery.Text(_filter.Driver),
            Client = TableQuery.Text(_filter.Client),
            Pickup = TableQuery.Text(_filter.Pickup),
            Dropoff = TableQuery.Text(_filter.Dropoff),
            PackageDetails = TableQuery.Text(_filter.PackageDetails),
            DeliveryNotes = TableQuery.Text(_filter.DeliveryNotes),
            Status = _filter.Status,
            CreatedFrom = _filter.CreatedFrom,
            CreatedTo = _filter.CreatedTo,
            OverdueOnly = _filter.OverdueOnly,
        };

    /// <summary>A text filter changed under the dispatcher's fingers: replace the history entry.</summary>
    private Task FilterTypedAsync() => MoveAsync(Filtered(), replace: true);

    /// <summary>A status, a date or the overdue switch changed: a history entry of its own.</summary>
    private Task FilterChosenAsync() => MoveAsync(Filtered(), replace: false);

    /// <summary>The row's edit action, for the same reason.</summary>
    private Func<Task> EditHandler(DeliverySummary delivery) => () => OpenEditAsync(delivery);

    /// <summary>The row's delete action, for the same reason.</summary>
    private Func<Task> DeleteHandler(DeliverySummary delivery) => () => OpenDeleteAsync(delivery);

    /// <summary>The location cell's action, for the same reason.</summary>
    private Func<Task> ShowLocationHandler(LocationView location) => () => ShowLocationAsync(location);

    /// <summary>The row's history action, for the same reason.</summary>
    private Func<Task> TimelineHandler(DeliverySummary delivery) => () => ShowTimelineAsync(delivery);

    /// <summary>The row's proof action, for the same reason.</summary>
    private Func<Task> ProofHandler(DeliverySummary delivery) => () => ShowProofAsync(delivery);

    /// <summary>
    /// The creation instant in local time (AD-13: storage is offset zero, and the conversion
    /// happens here, in the presentation layer, and nowhere else).
    /// </summary>
    /// <remarks>
    /// Local here is the server's configured zone, not the browser's: the shell renders
    /// interactively on the server, so <c>ToLocalTime</c> resolves against the host. The system is
    /// single-region, so configuring the host for it is the whole of the answer; reading the
    /// reader's own zone would need it carried from the browser, which nothing does yet.
    /// </remarks>
    private static string Created(DeliverySummary delivery) =>
        delivery.CreatedAt.ToLocalTime().ToString("g", System.Globalization.CultureInfo.CurrentCulture);

    /// <summary>
    /// The figures of a delivery window as the board's first column shows them (FR-100), in local
    /// time for the reason <see cref="Created" /> is.
    /// </summary>
    /// <remarks>
    /// The reading itself is <see cref="CellText.Window" />'s, because the own-deliveries screen
    /// renders the same window out of its own DTO and a second copy is the copy that drifts. What
    /// stays here is which two fields of this row type the window is: the shared reading takes the
    /// two bounds rather than a row, since the two screens' rows are different records.
    /// </remarks>
    private static string Window(DeliverySummary delivery) =>
        CellText.Window(delivery.WindowEarliestAt, delivery.WindowLatestAt);

    /// <summary>
    /// One driver as the assignment picker names them: who they are, and how they are thought of
    /// (FR-98).
    /// </summary>
    /// <remarks>
    /// Composed here rather than in markup because an <c>&lt;option&gt;</c> holds text and nothing
    /// else, so the three markup branches the roster uses have nowhere to go. The rating is
    /// formatted by <see cref="ReviewViews"/>, the same reading the roster gives it; a driver
    /// nobody has reviewed gets the "no value" text and never a zero — which is a rating, and the
    /// worst one the scale has.
    /// <para>
    /// FR-116's marker is appended and nothing else happens: an off-duty driver stays in the list
    /// and stays selectable. Dispatch routinely assigns a parcel to a driver whose shift starts
    /// later, so the requirement asks the form to <em>flag</em> rather than to refuse — and the
    /// words are <c>ShiftOpen</c>/<c>ShiftClosed</c>, the pickers' own pair, which are about the
    /// driver: whether this person is on duty now. <c>ShiftStateLabel</c> deliberately says
    /// something else with <c>ShiftRunning</c>/<c>ShiftFinished</c>, because a row in a history is
    /// a claim about a shift rather than about where its driver is. Do not merge the two pairs.
    /// </para>
    /// </remarks>
    private string DriverOption(DriverSummary driver) =>
        driver.FirstName + " " + driver.LastName + " — "
            + (driver.Rating is { } average ? ReviewViews.Format(average) : Localizer["NoRating"])
            + " — " + (driver.OnDuty ? Localizer["ShiftOpen"] : Localizer["ShiftClosed"]);

    /// <summary>
    /// True when the dispatcher has narrowed the board at all, which is the only state "clear the
    /// filters" is an answer to. A blank box is not a filter - the server reads it the same way.
    /// </summary>
    private bool IsFiltered =>
        Narrows(_filter.Driver)
        || Narrows(_filter.Client)
        || Narrows(_filter.Pickup)
        || Narrows(_filter.Dropoff)
        || Narrows(_filter.PackageDetails)
        || Narrows(_filter.DeliveryNotes)
        || _filter.Status is not null
        || _filter.CreatedFrom is not null
        || _filter.CreatedTo is not null
        || _filter.OverdueOnly;

    /// <summary>True when a text box holds something the rows are actually narrowed by.</summary>
    private static bool Narrows(string? value) => !string.IsNullOrWhiteSpace(value);

    /// <summary>
    /// What Enter in a filter box does, which is nothing.
    /// <para>
    /// The panel is a real <c>&lt;form&gt;</c> so the ten controls have a role and an accessible
    /// name, and a form submits. Every box is two-way bound and asks for its page as it is typed
    /// in, so there is nothing to send - and the default submission would be a GET to this same
    /// address that threw away every filter the dispatcher had set.
    /// </para>
    /// <para>
    /// A bound handler beside <c>@@onsubmit:preventDefault</c> rather than the directive on its own:
    /// the directive suppresses the browser's default for an event Blazor is handling, and this is
    /// the handler that makes it one. Nothing else in this solution writes it standalone, and a
    /// guard that only works if a framework detail holds is not a guard.
    /// </para>
    /// </summary>
    private static void KeepFilters()
    {
        // Deliberately empty: the filters are already applied.
    }

    private Task ResetFilters()
    {
        _filter = new DeliveryFilter();

        return MoveAsync(Filtered(), replace: false);
    }

    private void PickPickup(MapLocation picked) => _form.Pickup = picked;

    private void PickDropoff(MapLocation picked) => _form.Dropoff = picked;

    /// <summary>
    /// The three lists the form is built from. Read once rather than when the dialog opens, so
    /// choosing a driver does not wait on a round trip - and so the capacity hint has something to
    /// read the moment a driver is picked. Unpaged, every one of them: a picker capped at a table's
    /// page would leave the driver, client or vehicle on the next page impossible to choose.
    /// </summary>
    private async Task LoadPickersAsync()
    {
        _drivers = await DriverRoster.ListAllAsync(CircuitToken);
        _clients = await ClientRoster.ListAllAsync(CircuitToken);
        _vehicles = await VehicleFleet.ListAllAsync(CircuitToken);
    }

    private async Task OpenCreateAsync()
    {
        // A new form brings two new search boxes with it: they belong to the form rather than to the
        // screen, so a dialog opened on one delivery cannot offer the matches somebody searched for
        // while editing another.
        _failures = [];
        _form = new DeliveryForm();

        if (_formDialog is not null)
        {
            await _formDialog.ShowAsync();
        }
    }

    private async Task OpenEditAsync(DeliverySummary delivery)
    {
        _failures = [];
        _form = new DeliveryForm
        {
            Id = delivery.Id,
            Pickup = delivery.Pickup.Point,
            Dropoff = delivery.Dropoff.Point,
            PackageDetails = delivery.PackageDetails,
            PackageWeightKg = delivery.PackageWeightKg,
            DeliveryNotes = delivery.DeliveryNotes,
            WindowEarliestAt = delivery.WindowEarliestAt?.ToLocalTime(),
            WindowLatestAt = delivery.WindowLatestAt?.ToLocalTime(),
            DriverId = delivery.Driver?.Id,
            ClientId = delivery.Client?.Id,
        };

        if (_formDialog is not null)
        {
            await _formDialog.ShowAsync();
        }
    }

    private async Task CloseFormAsync()
    {
        if (_formDialog is not null)
        {
            await _formDialog.CloseAsync();
        }
    }

    private async Task ShowLocationAsync(LocationView location)
    {
        _viewed = location.Point;

        if (_mapDialog is not null)
        {
            await _mapDialog.ShowAsync();
        }
    }

    /// <summary>
    /// Chooses the row whose history to open. Rendering the panel is what opens it: it shows its
    /// own dialog after its first render.
    /// </summary>
    private Task ShowTimelineAsync(DeliverySummary delivery)
    {
        _failures = [];
        _timeline = delivery;

        return Task.CompletedTask;
    }

    /// <summary>
    /// Forgets which row the history dialog was showing, so the next open builds a new panel rather
    /// than reusing one holding a stale status and a half-typed note.
    /// </summary>
    private void CloseTimeline() => _timeline = null;

    private async Task ShowProofAsync(DeliverySummary delivery)
    {
        _failures = [];
        _proof = delivery;

        if (_proofDialog is not null)
        {
            await _proofDialog.ShowAsync();
        }
    }

    /// <inheritdoc cref="CloseTimeline" />
    private void CloseProof() => _proof = null;

    private async Task SaveAsync()
    {
        if (_saving)
        {
            return;
        }

        // Set before the await and cleared in the finally: the button is disabled from the moment
        // the first click is handled until the server has answered, so a second click has nothing
        // to act on.
        _saving = true;

        try
        {
            if (_form.Id is { } deliveryId)
            {
                // Every field present: this screen edits the whole card, so there is nothing for it
                // to leave alone. The Optional wrapper is still what carries them, because a later
                // caller sending only one field must mean the same thing to the same service - and
                // because an empty driver box has to reach the service as a present null (FR-16).
                await Dispatch.UpdateAsync(
                    deliveryId,
                    new UpdateDeliveryCommand(
                        Optional<LocationInput>.Present(Coordinates(_form.Pickup)),
                        Optional<LocationInput>.Present(Coordinates(_form.Dropoff)),
                        Optional<string>.Present(_form.PackageDetails),
                        Optional<decimal>.Present(_form.PackageWeightKg),
                        Optional<string?>.Present(_form.DeliveryNotes),
                        Optional<DateTimeOffset?>.Present(_form.WindowEarliestAt),
                        Optional<DateTimeOffset?>.Present(_form.WindowLatestAt),
                        Optional<int?>.Present(_form.DriverId),
                        Optional<int?>.Present(_form.ClientId)),
                    CircuitToken);
            }

            if (_form.Id is null)
            {
                await Dispatch.CreateAsync(
                    new CreateDeliveryCommand(
                        Coordinates(_form.Pickup),
                        Coordinates(_form.Dropoff),
                        _form.PackageDetails,
                        _form.PackageWeightKg,
                        _form.DeliveryNotes,
                        _form.WindowEarliestAt,
                        _form.WindowLatestAt,
                        _form.DriverId,
                        _form.ClientId),
                    CircuitToken);
            }

            _failures = [];

            await CloseFormAsync();
        }
        catch (DriveTrackException failure)
        {
            _failures = FailureKeys.For(failure);

            return;
        }
        finally
        {
            _saving = false;
        }

        // Outside the try, deliberately. The write has committed, so a failure refreshing the list
        // afterwards is a failed read, and reporting it as a refused save would tell the dispatcher
        // their delivery was not saved when it was.
        await LoadAsync();
    }

    private async Task OpenDeleteAsync(DeliverySummary delivery)
    {
        _failures = [];
        _pendingDeletion = delivery;

        if (_deleteDialog is not null)
        {
            await _deleteDialog.ShowAsync();
        }
    }

    private async Task ConfirmDeleteAsync()
    {
        if (_pendingDeletion is not { } delivery)
        {
            return;
        }

        _pendingDeletion = null;

        try
        {
            await Dispatch.DeleteAsync(delivery.Id, CircuitToken);

            _failures = [];
        }
        catch (DriveTrackException failure)
        {
            _failures = FailureKeys.For(failure);

            return;
        }

        // Outside the try: the delivery is gone, and a failed refresh afterwards must not be
        // reported as a delete that did not happen.
        await LoadAsync();
    }

    /// <summary>
    /// The coordinates a picked point sends, or null when nothing has been picked — which the
    /// service refuses with a field name rather than this screen guessing at one.
    /// </summary>
    private static LocationInput? Coordinates(MapLocation? point) =>
        point is { } value ? new LocationInput(value.Latitude, value.Longitude) : null;

    /// <summary>
    /// What the dispatcher has narrowed the board by (FR-20, FR-101), as the panel's boxes hold it. A
    /// plain settable class rather than a record: every field is two-way bound to an input, and
    /// resetting is a new instance. The server does the narrowing; this is only what the boxes say.
    /// </summary>
    internal sealed class DeliveryFilter
    {
        /// <summary>Text the driver's name must carry.</summary>
        public string? Driver { get; set; }

        /// <summary>Text the client's name must carry.</summary>
        public string? Client { get; set; }

        /// <summary>Text the pickup cell must carry.</summary>
        public string? Pickup { get; set; }

        /// <summary>Text the dropoff cell must carry.</summary>
        public string? Dropoff { get; set; }

        /// <summary>Text the package description must carry.</summary>
        public string? PackageDetails { get; set; }

        /// <summary>Text the notes must carry.</summary>
        public string? DeliveryNotes { get; set; }

        /// <summary>The only status to show, or null for every status.</summary>
        public DeliveryStatus? Status { get; set; }

        /// <summary>The earliest creation date to show, or null.</summary>
        public DateOnly? CreatedFrom { get; set; }

        /// <summary>The latest creation date to show, or null.</summary>
        public DateOnly? CreatedTo { get; set; }

        /// <summary>True to show only the deliveries whose window has passed (FR-19).</summary>
        public bool OverdueOnly { get; set; }
    }

    /// <summary>
    /// What the dialog is editing. A screen-local shape rather than a command: a command's update
    /// fields are <c>Optional&lt;T&gt;</c>, and two-way binding needs somewhere plain to write.
    /// </summary>
    /// <remarks>
    /// Internal rather than private because static rendering dispatches no events, so nothing a render test can do reaches the two
    /// address boxes, and the wiring between a box and the point it fills would otherwise be
    /// asserted nowhere at all.
    /// </remarks>
    internal sealed class DeliveryForm
    {
        /// <summary>The delivery being edited, or null while creating one.</summary>
        public int? Id { get; set; }

        public MapLocation? Pickup { get; set; }

        public MapLocation? Dropoff { get; set; }

        /// <summary>
        /// FR-104's box above the pickup map, wired to <em>this</em> form's pickup point.
        /// </summary>
        /// <remarks>
        /// Owned by the form rather than by the screen, and constructed here rather than assigned
        /// from outside. A box is only ever about one point, and building the pair beside the two
        /// fields they fill is what keeps "the dropoff box sets the dropoff" a single readable line
        /// instead of two handlers on the screen that could be crossed.
        /// </remarks>
        public PlaceSearch PickupSearch { get; }

        /// <inheritdoc cref="PickupSearch" />
        public PlaceSearch DropoffSearch { get; }

        /// <summary>A form with two empty address boxes, each bound to its own point.</summary>
        public DeliveryForm()
        {
            PickupSearch = new PlaceSearch(point => Pickup = point);
            DropoffSearch = new PlaceSearch(point => Dropoff = point);
        }

        public string? PackageDetails { get; set; }

        public decimal PackageWeightKg { get; set; }

        public string? DeliveryNotes { get; set; }

        public DateTimeOffset? WindowEarliestAt { get; set; }

        public DateTimeOffset? WindowLatestAt { get; set; }

        public int? DriverId { get; set; }

        public int? ClientId { get; set; }
    }
}
