@page "/vehicles"
@* FR-40 to FR-43: the dispatcher's fleet.

   The Roles argument routes a wrong role to /access-denied (FR-79) rather than into an error
   boundary. It is a convenience, not the decision: IAccessGuard.RequireRole inside IVehicleService
   settles whether this caller may manage the fleet, and it runs whether or not this screen was ever
   rendered.

   No @rendermode: the shell is globally InteractiveServerRenderMode(prerender: false), so this page
   is interactive by inheritance and @bind works without [SupplyParameterFromForm].

   The @if blocks below are independent rather than if/else chains: an `else` at markup level reads
   to NFR-14's source scan as a rendered English word. *@
@attribute [Authorize(Roles = "Dispatcher,Admin")]
@* Named for what it is rather than for the capability: a member called `Vehicles` on a
   component called `Vehicles` does not compile. *@
@inject IVehicleService Fleet
@inject ICurrentUser Caller
@inject IStringLocalizer<UiText> Localizer
@inherits PagedScreen<ListVehiclesQuery, VehicleSummary, VehicleSort>

<PageTitle>@Localizer["VehiclesTitle"]</PageTitle>

@* The screen's title and the one action that opens an empty form, on one line - the shape the two
   delivery screens already settled. The create action is about the fleet rather than about any
   vehicle in it, so it belongs beside the heading that names the fleet; the search box narrows that
   same collection, which is why it stays in its own row below rather than on this line. *@
<div class="dt-page-head mb-4">
    <h1 class="dt-type-h1">
        <Icon Name="IconName.Vehicles" />@Localizer["VehiclesTitle"]
    </h1>

    <button type="button" class="btn btn-primary dt-vehicle-create" @onclick="OpenCreateAsync">
        <Icon Name="IconName.Create" />@Localizer["AddVehicle"]
    </button>
</div>

@* FR-43's refusal arrives here: the localized FLEET_VEHICLE_IN_USE message tells the dispatcher to
   unassign the driver first, which is a way out the original system did not have. Resolved through
   the same catalogue the REST envelope uses, so the two cannot disagree (NFR-3).

   It carries a delete refusal and anything else the four boxes below have not claimed; each of
   those states its own refusal under itself through DtFieldError. *@
<DtFailureBanner Failures="_failures" InlineFields="@InlineFields" />

@* One box, so a plain labelled input rather than the dispatch board's bounded filter panel: ten
   filters earn a panel with a name and a reset of its own, and one search box does not. The two
   list vocabularies diverge here on purpose, and that is the reason. *@
<div class="row g-4 mb-4">
    <div class="col-sm">
        <label class="form-label" for="vehicles-search">@Localizer["Search"]</label>
        @* Answered by the server over the whole fleet, and written into the address as it is
           typed - replacing the history entry rather than adding one per keystroke. *@
        <input id="vehicles-search" type="search" class="form-control"
               @bind="_search" @bind:event="oninput" @bind:after="SearchChangedAsync" />
    </div>
</div>

@* NFR-27: one page of the fleet at a time, searched and sorted by the server over every vehicle,
   with the pager under the table saying how far through the fleet the page is. *@
@* `dt-table-cards` is where this screen opts into the shared collapse: below the phone breakpoint
   the table's rows stop being rows and become cards. The collapse is stated once, in
   `_theme.scss`, so nothing about it is written here or in this screen's own stylesheet - and
   because it is a global rule rather than a scoped one, none of it needs a `::deep`.

   The wrapper's own name stays beside it. `Vehicles.razor.css` hangs this screen's per-cell label
   rules off it, and the phone-layout suite reads it as the element the table has to be inside. *@
<div class="dt-vehicles dt-table-cards">
    <DtDataTable TItem="VehicleSummary"
                 Page="Listed"
                 OnPage="GoToPageAsync"
                 OnPageSize="ResizeAsync"
                 CountOne="@Localizer["VehiclesCountOne"]"
                 CountMany="@Localizer["VehiclesCountMany"]"
                 IsLoading="Loading"
                 EmptyText="@Localizer["VehiclesEmpty"]">
        <HeaderTemplate>
            @* A heading is the sort control, as on the dispatch board: the handler, the ARIA state
               and the glyph all come from methods, because a `=>` inside an attribute closes the tag
               as far as NFR-14's source scan is concerned. *@
            <th scope="col" aria-sort="@SortState(VehicleSort.Model)">
                <button type="button" class="btn btn-link btn-sm" @onclick="SortHandler(VehicleSort.Model)">
                    @Localizer["Model"]<Icon Name="@SortGlyph(VehicleSort.Model)" />
                </button>
            </th>
            <th scope="col" aria-sort="@SortState(VehicleSort.LicensePlate)">
                <button type="button" class="btn btn-link btn-sm" @onclick="SortHandler(VehicleSort.LicensePlate)">
                    @Localizer["LicensePlate"]<Icon Name="@SortGlyph(VehicleSort.LicensePlate)" />
                </button>
            </th>
            <th scope="col" aria-sort="@SortState(VehicleSort.CapacityKg)">
                <button type="button" class="btn btn-link btn-sm" @onclick="SortHandler(VehicleSort.CapacityKg)">
                    @Localizer["CapacityKg"]<Icon Name="@SortGlyph(VehicleSort.CapacityKg)" />
                </button>
            </th>
            @* The actions column keeps its name for a screen reader and drops it on screen, as the
               two delivery screens' does: the buttons under it say what they do, and a column named
               above them competes with them for the same width. *@
            <th scope="col" class="dt-table-actions">
                <span class="dt-visually-hidden">@Localizer["Actions"]</span>
            </th>
        </HeaderTemplate>
        <RowTemplate Context="vehicle">
            @* The per-cell name, carried by the cell rather than only by the column heading. Not
               the same thing on both sides of the breakpoint: above it the span is dropped, where
               the `<th>` already names the column and a second name in every cell would be that
               name read twice a row; below it the head is gone and the span is painted, as
               something a reader can see, and that is what replaces it. *@
            <td>
                <span class="dt-visually-hidden dt-vehicle-label">@Localizer["Model"]</span>
                @vehicle.Model
            </td>
            <td>
                <span class="dt-visually-hidden dt-vehicle-label">@Localizer["LicensePlate"]</span>
                @* A plate is a string a reader compares character by character, which a
                   proportional font makes harder than it needs to be. *@
                <span class="dt-type-code">@vehicle.LicensePlate</span>
            </td>
            <td>
                <span class="dt-visually-hidden dt-vehicle-label">@Localizer["CapacityKg"]</span>
                @vehicle.CapacityKg
            </td>
            @* `dt-table-actions` rather than a class of this screen's own: the right-aligned,
               nowrapped actions column is DtDataTable's own rule, and the cell has to wear the
               class its heading already wears to be reached by it. *@
            <td class="dt-table-actions">
                <span class="dt-visually-hidden dt-vehicle-label">@Localizer["Actions"]</span>
                @* The handlers are built in code rather than written as lambdas here: a `=>` inside
                   an attribute closes the tag as far as a source scan is concerned. *@
                <button type="button" class="btn btn-secondary btn-sm dt-vehicle-edit"
                        @onclick="EditHandler(vehicle)">
                    <Icon Name="IconName.Edit" />@Localizer["Edit"]
                </button>
                <button type="button" class="btn btn-danger btn-sm dt-vehicle-delete"
                        @onclick="DeleteHandler(vehicle)">
                    <Icon Name="IconName.Delete" />@Localizer["Delete"]
                </button>
            </td>
        </RowTemplate>
    </DtDataTable>
</div>

@* FR-85: the shared dialog. One heading for both create and edit - a title composed at run time
   would be a key no test can see, and the catalogue is closed against the keys components ask for. *@
<DtDialog @ref="_formDialog" Title="@Localizer["VehicleForm"]" OnClosed="ClearFailures">
    <ChildContent>
        @* The same list as the one at the top of the page, and deliberately a second copy. A
           DtDialog opens with showModal(), so everything outside it is in the inert layer
           behind the backdrop: a duplicate plate refused with the message only up there is a
           form that fails to close and says nothing, which is not FR-41's "clear message".
           The page-level copy still carries the refusals raised with no dialog open - FR-43's
           held-vehicle delete, above all. *@
        <DtFailureBanner Failures="_failures" InlineFields="@InlineFields" />

        <EditForm id="vehicle-form" Model="_form" OnValidSubmit="SaveAsync">
            @* Clearing a number or a date field leaves a parse failure on the EditContext, and
               OnValidSubmit then never fires - so without this the Save button would do
               nothing and say nothing. ValidationSummary rather than per-field
               ValidationMessage: a `For="@(() => ...)"` lambda inside an attribute is the
               construct NFR-14's source scan misreads. *@
            <ValidationSummary />
            <div class="mb-4">
                <label class="form-label" for="vehicle-model">@Localizer["Model"]</label>
                <InputText id="vehicle-model" class="form-control" @bind-Value="_form.Model" />
                <DtFieldError Field="Model" Failures="_failures" />
            </div>
            <div class="mb-4">
                <label class="form-label" for="vehicle-license-plate">@Localizer["LicensePlate"]</label>
                <InputText id="vehicle-license-plate" class="form-control"
                           @bind-Value="_form.LicensePlate" />
                <DtFieldError Field="LicensePlate" Failures="_failures" />
            </div>
            <div class="mb-4">
                <label class="form-label" for="vehicle-capacity">@Localizer["CapacityKg"]</label>
                @* No {0} in the message: the framework fills it with the CLR property name,
                   which would put a Latin word in front of a user (NFR-14). *@
                <InputNumber id="vehicle-capacity" class="form-control"
                             ParsingErrorMessage="@Localizer["NumberParseError"]"
                             @bind-Value="_form.CapacityKg" />
                <DtFieldError Field="CapacityKg" Failures="_failures" />
            </div>
            @* FR-40 records these two; nothing in this milestone reads them, and PRD section 8
               excludes the maintenance alerting rather than the fields. So they belong on the form,
               where a dispatcher captures them, and not in the table above, which shows what a
               screen in this milestone actually needs to read. *@
            <div class="mb-4">
                <label class="form-label" for="vehicle-mileage">@Localizer["Mileage"]</label>
                <InputNumber id="vehicle-mileage" class="form-control"
                             ParsingErrorMessage="@Localizer["NumberParseError"]"
                             @bind-Value="_form.Mileage" />
                <DtFieldError Field="Mileage" Failures="_failures" />
            </div>
            <div class="mb-4">
                <label class="form-label" for="vehicle-maintenance">@Localizer["NextMaintenanceDate"]</label>
                <InputDate id="vehicle-maintenance" class="form-control"
                           ParsingErrorMessage="@Localizer["DateParseError"]"
                           @bind-Value="_form.NextMaintenanceDate" />
            </div>
        </EditForm>
    </ChildContent>
    <Actions>
        @* Disabled while a save is in flight: the circuit yields at the await, so a second click
           would dispatch a second write before the first has answered. *@
        <button type="submit" form="vehicle-form" class="dt-vehicle-save @SaveVariant" disabled="@_saving">
            <Icon Name="@SaveGlyph" />@Localizer["Save"]
        </button>
        <button type="button" class="btn btn-outline-secondary" @onclick="CloseFormAsync">
            <Icon Name="IconName.Close" />@Localizer["Cancel"]
        </button>
    </Actions>
</DtDialog>

@* FR-81: a destructive action is confirmed through the shared prompt. *@
<DtConfirmDialog @ref="_deleteDialog"
                 Title="@Localizer["DeleteVehicleTitle"]"
                 Message="@Localizer["DeleteVehicleMessage"]"
                 OnConfirmed="ConfirmDeleteAsync" />

@code {

    /// <summary>
    /// Drops the refusals when the form is dismissed, however it was dismissed.
    /// <para>
    /// FR-83. A refusal claimed by a box inside the dialog is subtracted from the banner outside it,
    /// so leaving the list populated past the close would leave that sentence with nowhere on the
    /// page to render - invisible, which is the outcome this whole change exists to prevent.
    /// Hung off <c>OnClosed</c> rather than off the cancel handler because Escape and the backdrop
    /// dismiss the dialog too, and the component routes all three through one event.
    /// </para>
    /// </summary>
    private void ClearFailures() => _failures = [];
    /// <summary>
    /// The boxes this screen renders a <c>DtFieldError</c> for. Stated once and bound by every
    /// banner on the page: the list repeated per banner is exactly the drift FR-83 is broken by,
    /// and a screen carries the banner more than once because a dialog opened with showModal()
    /// leaves the page behind it inert.
    /// </summary>
    private const string InlineFields = "Model,LicensePlate,CapacityKg,Mileage";

    private IReadOnlyList<ScreenFailure> _failures = [];
    /// <summary>
    /// The save action's variant, which follows the mode the dialog is in: creating a record is a
    /// create action and takes the create colour, and changing one that already exists is an edit.
    /// <para>
    /// One dialog serves both modes, so the button is the only thing on screen that can say which
    /// one the reader is in - and AD-28 gives the two actions different colours precisely so that
    /// it does. Resolved here rather than as a ternary in the attribute, for the reason
    /// <c>DtDialog</c> resolves its panel class into a property.
    /// </para>
    /// <para>
    /// Only the variant: the hook stays written out on the button itself, so the source still shows
    /// which control this is - and it is the hook a test names, because asserting the mode by the
    /// variant would be a test that passes the day somebody paints a delete button teal.
    /// </para>
    /// </summary>
    private string SaveVariant => _form.Id is null
        ? "btn btn-primary"
        : "btn btn-secondary";

    /// <summary>
    /// The glyph beside it, following the same mode: the create mark when the dialog is making a
    /// record and the confirm mark when it is saving changes to one. The icon and the colour move
    /// together, because colour is never allowed to be the only signal.
    /// </summary>
    private IconName SaveGlyph => _form.Id is null ? IconName.Create : IconName.Confirm;

    private VehicleForm _form = new();
    private VehicleSummary? _pendingDeletion;
    private DtDialog? _formDialog;
    private DtConfirmDialog? _deleteDialog;
    private string _search = string.Empty;

    /// <summary>
    /// True while a save is in flight, which is what disables the submit button for as long as it
    /// lasts. The circuit yields at the await, so without it a second click dispatches a second
    /// write against a form the first one has not finished with.
    /// </summary>
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        // The circuit outlives the request that opened it, so the cookie can be gone by the time a
        // screen calls a service. Raising the contract's own code here is what puts that case
        // through FR-13's single boundary instead of a per-screen redirect.
        if (!Caller.IsAuthenticated)
        {
            throw new ForbiddenException(
                ErrorCode.AUTH_UNAUTHENTICATED,
                "The circuit has no authenticated caller: the session cookie is gone.");
        }

        // The first page is the address's to choose: PagedScreen reads it once the query string
        // has been supplied, and loads it.
        await base.OnInitializedAsync();
    }

    /// <inheritdoc />
    protected override VehicleSort DefaultSort => VehicleSort.Model;

    /// <inheritdoc />
    protected override IReadOnlyCollection<VehicleSort> Sortable { get; } =
        [VehicleSort.Model, VehicleSort.LicensePlate, VehicleSort.CapacityKg];

    /// <inheritdoc />
    protected override ListVehiclesQuery Compose(int offset, int limit, VehicleSort sort, bool descending) =>
        new(offset, limit, sort.ToString(), descending, TableQuery.Text(SearchParameter));

    /// <inheritdoc />
    protected override (int Offset, int Limit, VehicleSort Sort, bool Descending) Paging(ListVehiclesQuery view) =>
        (view.Offset, view.Limit, ListSort.Parse<VehicleSort>(view.Sort) ?? DefaultSort, view.Descending);

    /// <inheritdoc />
    protected override ListVehiclesQuery Repaged(
        ListVehiclesQuery view,
        int offset,
        int limit,
        VehicleSort sort,
        bool descending) =>
        view with { Offset = offset, Limit = limit, Sort = sort.ToString(), Descending = descending };

    /// <inheritdoc />
    protected override void AddFilters(ListVehiclesQuery view, IDictionary<string, object?> address) =>
        address[TableQuery.SearchName] = view.Search;

    /// <inheritdoc />
    protected override void Adopt(ListVehiclesQuery view) => _search = view.Search ?? string.Empty;

    /// <inheritdoc />
    protected override async Task<Paged<VehicleSummary>?> FetchAsync(ListVehiclesQuery view) =>
        await Fleet.ListAsync(view, CircuitToken);

    /// <summary>The search box changed: page one of what it now matches, replacing the history entry.</summary>
    private Task SearchChangedAsync() =>
        MoveAsync(FirstPage(View) with { Search = TableQuery.Text(_search) }, replace: true);

    /// <summary>The row's edit action, bound as a delegate so no lambda has to live in markup.</summary>
    private Func<Task> EditHandler(VehicleSummary vehicle) => () => OpenEditAsync(vehicle);

    /// <summary>The row's delete action, for the same reason.</summary>
    private Func<Task> DeleteHandler(VehicleSummary vehicle) => () => OpenDeleteAsync(vehicle);

    private async Task OpenCreateAsync()
    {
        _failures = [];
        _form = new VehicleForm();

        if (_formDialog is not null)
        {
            await _formDialog.ShowAsync();
        }
    }

    private async Task OpenEditAsync(VehicleSummary vehicle)
    {
        _failures = [];
        _form = new VehicleForm
        {
            Id = vehicle.Id,
            Model = vehicle.Model,
            LicensePlate = vehicle.LicensePlate,
            CapacityKg = vehicle.CapacityKg,
            Mileage = vehicle.Mileage,
            NextMaintenanceDate = vehicle.NextMaintenanceDate,
        };

        if (_formDialog is not null)
        {
            await _formDialog.ShowAsync();
        }
    }

    private async Task CloseFormAsync()
    {
        if (_formDialog is not null)
        {
            await _formDialog.CloseAsync();
        }
    }

    private async Task SaveAsync()
    {
        if (_saving)
        {
            return;
        }

        // Set before the await and cleared in the finally: the button is disabled from the moment
        // the first click is handled until the server has answered, so a second click has nothing
        // to act on.
        _saving = true;

        try
        {
            if (_form.Id is { } vehicleId)
            {
                // Every field present: this screen edits the whole card, so there is nothing for it
                // to leave alone. The Optional wrapper is still what carries them, because a later
                // caller sending only one field must mean the same thing to the same service.
                await Fleet.UpdateAsync(
                    vehicleId,
                    new UpdateVehicleCommand(
                        Optional<string>.Present(_form.Model),
                        Optional<string>.Present(_form.LicensePlate),
                        Optional<decimal>.Present(_form.CapacityKg),
                        Optional<int>.Present(_form.Mileage),
                        // Present, and null when the dispatcher cleared the field: on this one
                        // column "no value" is a state they can choose (FR-42).
                        Optional<DateOnly?>.Present(_form.NextMaintenanceDate)),
                    CircuitToken);
            }

            if (_form.Id is null)
            {
                await Fleet.CreateAsync(
                    new CreateVehicleCommand(
                        _form.Model,
                        _form.LicensePlate,
                        _form.CapacityKg,
                        _form.Mileage,
                        _form.NextMaintenanceDate),
                    CircuitToken);
            }

            _failures = [];

            await CloseFormAsync();
        }
        catch (DriveTrackException failure)
        {
            _failures = FailureKeys.For(failure);

            return;
        }
        finally
        {
            _saving = false;
        }

        // Outside the try, deliberately. The write has committed, so a failure refreshing the
        // list afterwards is a failed read, and reporting it as a refused save would tell the
        // dispatcher their vehicle was not saved when it was.
        await LoadAsync();
    }

    private async Task OpenDeleteAsync(VehicleSummary vehicle)
    {
        _failures = [];
        _pendingDeletion = vehicle;

        if (_deleteDialog is not null)
        {
            await _deleteDialog.ShowAsync();
        }
    }

    private async Task ConfirmDeleteAsync()
    {
        if (_pendingDeletion is not { } vehicle)
        {
            return;
        }

        _pendingDeletion = null;

        try
        {
            await Fleet.DeleteAsync(vehicle.Id, CircuitToken);

            _failures = [];
        }
        catch (DriveTrackException failure)
        {
            // FR-43: a held vehicle is refused, and the message above says what to do about it.
            _failures = FailureKeys.For(failure);

            return;
        }

        // Outside the try: the vehicle is gone, and a failed refresh afterwards must not be
        // reported as a delete that did not happen.
        await LoadAsync();
    }

    /// <summary>
    /// What the dialog is editing. A screen-local shape rather than a command: a command's update
    /// fields are <c>Optional&lt;T&gt;</c>, and two-way binding needs somewhere plain to write.
    /// </summary>
    private sealed class VehicleForm
    {
        /// <summary>The vehicle being edited, or null while creating one.</summary>
        public int? Id { get; set; }

        public string? Model { get; set; }

        public string? LicensePlate { get; set; }

        public decimal CapacityKg { get; set; }

        public int Mileage { get; set; }

        public DateOnly? NextMaintenanceDate { get; set; }
    }
}
