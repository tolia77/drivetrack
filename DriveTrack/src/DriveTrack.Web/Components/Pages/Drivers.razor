@page "/drivers"
@* FR-35 to FR-39, FR-45: the dispatcher's driver roster.

   The Roles argument is what routes a wrong role to /access-denied (FR-79) rather than into an
   error boundary. It is still a convenience, not the decision: IAccessGuard.RequireRole inside
   IDriverService settles whether this caller may do any of this, and it runs whether or not the
   screen was ever rendered.

   No @rendermode: the shell is globally InteractiveServerRenderMode(prerender: false), so this page
   is interactive by inheritance and @bind works without [SupplyParameterFromForm].

   The @if blocks below are independent rather than if/else chains: an `else` at markup level reads
   to NFR-14's source scan as a rendered English word, and the conditions exclude each other
   anyway. *@
@attribute [Authorize(Roles = "Dispatcher,Admin")]
@* Named for what they are rather than for the capability: a member called `Drivers` on a
   component called `Drivers` does not compile. *@
@inject IDriverService Roster
@inject IVehicleService Fleet
@inject ICurrentUser Caller
@inject IStringLocalizer<UiText> Localizer
@inherits PagedScreen<ListDriversQuery, DriverSummary, DriverSort>

<PageTitle>@Localizer["DriversTitle"]</PageTitle>

@* The screen's title and the one action that opens an empty form, on one line - the shape the two
   delivery screens already settled. The create action is about the roster rather than about any
   driver in it, so it belongs beside the heading that names the roster; the search box narrows that
   same collection, which is why it stays in its own row below rather than on this line. *@
<div class="dt-page-head mb-4">
    <h1 class="dt-type-h1">
        <Icon Name="IconName.Drivers" />@Localizer["DriversTitle"]
    </h1>

    <button type="button" class="btn btn-primary dt-driver-create" @onclick="OpenCreateAsync">
        <Icon Name="IconName.Create" />@Localizer["AddDriver"]
    </button>
</div>

@* NFR-3: the message is the localized string for the code the service threw, resolved through the
   same catalogue the REST envelope uses. Nothing an exception carries reaches this page. *@
<DtFailureBanner Failures="_failures" InlineFields="@InlineFields" />

@* One box, so a plain labelled input rather than the dispatch board's bounded filter panel: ten
   filters earn a panel with a name and a reset of its own, and one search box does not. The two
   list vocabularies diverge here on purpose, and that is the reason. *@
<div class="row g-4 mb-4">
    <div class="col-sm">
        <label class="form-label" for="drivers-search">@Localizer["Search"]</label>
        @* FR-36, answered by the server over the whole roster - name, email, licence number and
           vehicle - and written into the address as it is typed, replacing the history entry
           rather than adding one per keystroke. *@
        <input id="drivers-search" type="search" class="form-control"
               @bind="_search" @bind:event="oninput" @bind:after="SearchChangedAsync" />
    </div>
</div>

@* `dt-table-cards` is where this screen opts into the shared collapse: below the phone breakpoint
   the table's rows stop being rows and become cards. The collapse is stated once, in
   `_theme.scss`, so nothing about it is written here or in this screen's own stylesheet - and
   because it is a global rule rather than a scoped one, none of it needs a `::deep`.

   The wrapper's own name stays beside it. `Drivers.razor.css` hangs this screen's per-cell label
   rules off it, and the phone-layout suite reads it as the element the table has to be inside. *@
<div class="dt-drivers dt-table-cards">
    <DtDataTable TItem="DriverSummary"
                 Page="Listed"
                 OnPage="GoToPageAsync"
                 OnPageSize="ResizeAsync"
                 CountOne="@Localizer["DriversCountOne"]"
                 CountMany="@Localizer["DriversCountMany"]"
                 IsLoading="Loading"
                 EmptyText="@Localizer["DriversEmpty"]">
        <HeaderTemplate>
            <th scope="col" aria-sort="@SortState(DriverSort.FirstName)">
                <button type="button" class="btn btn-link btn-sm" @onclick="SortHandler(DriverSort.FirstName)">
                    @Localizer["FirstName"]<Icon Name="@SortGlyph(DriverSort.FirstName)" />
                </button>
            </th>
            <th scope="col" aria-sort="@SortState(DriverSort.LastName)">
                <button type="button" class="btn btn-link btn-sm" @onclick="SortHandler(DriverSort.LastName)">
                    @Localizer["LastName"]<Icon Name="@SortGlyph(DriverSort.LastName)" />
                </button>
            </th>
            <th scope="col" aria-sort="@SortState(DriverSort.Email)">
                <button type="button" class="btn btn-link btn-sm" @onclick="SortHandler(DriverSort.Email)">
                    @Localizer["Email"]<Icon Name="@SortGlyph(DriverSort.Email)" />
                </button>
            </th>
            <th scope="col" aria-sort="@SortState(DriverSort.LicenseNumber)">
                <button type="button" class="btn btn-link btn-sm" @onclick="SortHandler(DriverSort.LicenseNumber)">
                    @Localizer["LicenseNumber"]<Icon Name="@SortGlyph(DriverSort.LicenseNumber)" />
                </button>
            </th>
            <th scope="col" aria-sort="@SortState(DriverSort.Vehicle)">
                <button type="button" class="btn btn-link btn-sm" @onclick="SortHandler(DriverSort.Vehicle)">
                    @Localizer["Vehicle"]<Icon Name="@SortGlyph(DriverSort.Vehicle)" />
                </button>
            </th>
            <th scope="col" aria-sort="@SortState(DriverSort.Rating)">
                <button type="button" class="btn btn-link btn-sm" @onclick="SortHandler(DriverSort.Rating)">
                    @Localizer["Rating"]<Icon Name="@SortGlyph(DriverSort.Rating)" />
                </button>
            </th>
            @* The actions column keeps its name for a screen reader and drops it on screen, as the
               two delivery screens' does: the buttons under it say what they do, and a column named
               above them competes with them for the same width. *@
            <th scope="col" class="dt-table-actions">
                <span class="dt-visually-hidden">@Localizer["Actions"]</span>
            </th>
        </HeaderTemplate>
        <RowTemplate Context="driver">
            @* The per-cell name, carried by the cell rather than only by the column heading. Not
               the same thing on both sides of the breakpoint: above it the span is dropped, where
               the `<th>` already names the column and a second name in every cell would be that
               name read twice a row; below it the head is gone and the span is painted, as
               something a reader can see, and that is what replaces it. *@
            <td>
                <span class="dt-visually-hidden dt-driver-label">@Localizer["FirstName"]</span>
                @driver.FirstName
            </td>
            <td>
                <span class="dt-visually-hidden dt-driver-label">@Localizer["LastName"]</span>
                @driver.LastName
            </td>
            <td>
                <span class="dt-visually-hidden dt-driver-label">@Localizer["Email"]</span>
                @driver.Email
            </td>
            <td>
                <span class="dt-visually-hidden dt-driver-label">@Localizer["LicenseNumber"]</span>
                @driver.LicenseNumber
            </td>
            <td>
                <span class="dt-visually-hidden dt-driver-label">@Localizer["Vehicle"]</span>
                @if (driver.VehicleId is null)
                {
                    <span>@Localizer["NoVehicle"]</span>
                }
                @if (driver.VehicleId is not null)
                {
                    <span>@driver.VehicleModel — @driver.VehicleLicensePlate</span>
                }
            </td>
            <td>
                <span class="dt-visually-hidden dt-driver-label">@Localizer["Rating"]</span>
                @* FR-98: the aggregate, derived on demand and never stored. Null and zero are
                   different claims - nobody has said anything, versus everybody said the worst
                   thing - and the shared display is what keeps the two apart: a driver with no
                   reviews gets words and no stars rather than a number, and wears none of the three
                   band colours, because the absence of a verdict is not a verdict. The band is
                   Domain's reading of the number, through ReviewViews; no threshold and no colour
                   is written here (AD-18, AD-28). *@
                <DtRatingDisplay Rating="driver.Rating" />
            </td>
            @* `dt-table-actions` rather than a class of this screen's own: the right-aligned,
               nowrapped actions column is DtDataTable's own rule, and the cell has to wear the
               class its heading already wears to be reached by it. *@
            <td class="dt-table-actions">
                <span class="dt-visually-hidden dt-driver-label">@Localizer["Actions"]</span>
                @* The handler is built in code rather than written as a lambda here: a `=>` inside
                   an attribute closes the tag as far as a source scan is concerned, and everything
                   after it reads as rendered English. *@
                <button type="button" class="btn btn-secondary btn-sm dt-driver-edit"
                        @onclick="EditHandler(driver)">
                    <Icon Name="IconName.Edit" />@Localizer["Edit"]
                </button>
                <button type="button" class="btn btn-danger btn-sm dt-driver-delete"
                        @onclick="DeleteHandler(driver)">
                    <Icon Name="IconName.Delete" />@Localizer["Delete"]
                </button>
            </td>
        </RowTemplate>
    </DtDataTable>
</div>

@* FR-85: the one dialog every screen opens, rather than a modal of this screen's own. *@
@* One heading for both create and edit. A title composed at run time would be a key no test can
   see, and the catalogue is closed against the keys components literally ask for. *@
<DtDialog @ref="_formDialog" Title="@Localizer["DriverForm"]" OnClosed="ClearFailures">
    <ChildContent>
        @* The same list as the one at the top of the page, and deliberately a second copy. A
           DtDialog opens with showModal(), so everything outside it is in the inert layer
           behind the backdrop: a refusal rendered only up there is a message nobody can see,
           and the form would simply fail to close. The page-level copy still carries the
           refusals raised with no dialog open - a delete, above all.

           InlineFields is computed rather than written out: the address and the password are
           create-only boxes, and claiming one this render does not show would be the one way a
           refusal could go missing (FR-83). *@
        <DtFailureBanner Failures="_failures" InlineFields="@InlineFields" />

        <EditForm id="driver-form" Model="_form" OnValidSubmit="SaveAsync">
            @* A parse failure from an input the framework could not read lands on the
               EditContext and stops OnValidSubmit firing at all, so without this the Save
               button would do nothing and say nothing. ValidationSummary rather than per-field
               ValidationMessage: a `For="@(() => ...)"` lambda inside an attribute is the
               construct NFR-14's source scan misreads. *@
            <ValidationSummary />
            @* FR-37 names the driver's name among the things a dispatcher may change, so these two
               are on both the create and the edit form. *@
            <div class="mb-4">
                <label class="form-label" for="driver-first-name">@Localizer["FirstName"]</label>
                <InputText id="driver-first-name" class="form-control" @bind-Value="_form.FirstName" />
                <DtFieldError Field="FirstName" Failures="_failures" />
            </div>
            <div class="mb-4">
                <label class="form-label" for="driver-last-name">@Localizer["LastName"]</label>
                <InputText id="driver-last-name" class="form-control" @bind-Value="_form.LastName" />
                <DtFieldError Field="LastName" Failures="_failures" />
            </div>

            @* The address and the password are create-only. FR-37 does not name them, and AD-24
               keeps this screen's reach into an account to what a requirement asks for. *@
            @if (_form.Id is null)
            {
                <div class="mb-4">
                    <label class="form-label" for="driver-email">@Localizer["Email"]</label>
                    <InputText id="driver-email" class="form-control" @bind-Value="_form.Email" />
                    <DtFieldError Field="Email" Failures="_failures" />
                </div>
                <div class="mb-4">
                    <label class="form-label" for="driver-password">@Localizer["Password"]</label>
                    <InputText id="driver-password" type="password" class="form-control"
                               @bind-Value="_form.Password" />
                    <DtFieldError Field="Password" Failures="_failures" />
                </div>
            }

            <div class="mb-4">
                <label class="form-label" for="driver-license-number">@Localizer["LicenseNumber"]</label>
                <InputText id="driver-license-number" class="form-control"
                           @bind-Value="_form.LicenseNumber" />
                <DtFieldError Field="LicenseNumber" Failures="_failures" />
            </div>

            <div class="mb-4">
                <label class="form-label" for="driver-vehicle">@Localizer["Vehicle"]</label>
                @* FR-45 and FR-38 in one control: the choices are the vehicles nobody holds, and the
                   empty option is an explicit "no vehicle" - which is how a dispatcher releases an
                   assignment. The original had no such choice, so an assigned vehicle stayed
                   assigned for good. *@
                <DtSelect Id="driver-vehicle" @bind-Value="_form.VehicleId">
                    <option value="">@Localizer["NoVehicle"]</option>
                    @foreach (var vehicle in _vehicleChoices)
                    {
                        <option value="@vehicle.Id">@vehicle.Model — @vehicle.LicensePlate</option>
                    }
                </DtSelect>
            </div>
        </EditForm>
    </ChildContent>
    <Actions>
        @* Disabled while a save is in flight: the circuit yields at the await, so a second click
           would create a second account from the same form. *@
        <button type="submit" form="driver-form" class="dt-driver-save @SaveVariant" disabled="@_saving">
            <Icon Name="@SaveGlyph" />@Localizer["Save"]
        </button>
        <button type="button" class="btn btn-outline-secondary" @onclick="CloseFormAsync">
            <Icon Name="IconName.Close" />@Localizer["Cancel"]
        </button>
    </Actions>
</DtDialog>

@* FR-81: a destructive action is confirmed through the shared prompt, never performed on the click
   that asked for it. *@
<DtConfirmDialog @ref="_deleteDialog"
                 Title="@Localizer["DeleteDriverTitle"]"
                 Message="@Localizer["DeleteDriverMessage"]"
                 OnConfirmed="ConfirmDeleteAsync" />

@code {

    /// <summary>
    /// Drops the refusals when the form is dismissed, however it was dismissed.
    /// <para>
    /// FR-83. A refusal claimed by a box inside the dialog is subtracted from the banner outside it,
    /// so leaving the list populated past the close would leave that sentence with nowhere on the
    /// page to render - invisible, which is the outcome this whole change exists to prevent.
    /// Hung off <c>OnClosed</c> rather than off the cancel handler because Escape and the backdrop
    /// dismiss the dialog too, and the component routes all three through one event.
    /// </para>
    /// </summary>
    private void ClearFailures() => _failures = [];
    /// <summary>
    /// The boxes the dialog is rendering, which is what both banners subtract. Computed rather than
    /// written out because the address and the password are create-only: claiming a field this
    /// render does not show would hide a refusal with nowhere else to appear (FR-83).
    /// </summary>
    private string InlineFields => _form.Id is null
        ? "FirstName,LastName,Email,Password,LicenseNumber"
        : "FirstName,LastName,LicenseNumber";

    private IReadOnlyList<VehicleChoice> _vehicleChoices = [];
    private IReadOnlyList<ScreenFailure> _failures = [];
    /// <summary>
    /// The save action's variant, which follows the mode the dialog is in: creating a record is a
    /// create action and takes the create colour, and changing one that already exists is an edit.
    /// <para>
    /// One dialog serves both modes, so the button is the only thing on screen that can say which
    /// one the reader is in - and AD-28 gives the two actions different colours precisely so that
    /// it does. Resolved here rather than as a ternary in the attribute, for the reason
    /// <c>DtDialog</c> resolves its panel class into a property.
    /// </para>
    /// <para>
    /// Only the variant: the hook stays written out on the button itself, so the source still shows
    /// which control this is - and it is the hook a test names, because asserting the mode by the
    /// variant would be a test that passes the day somebody paints a delete button teal.
    /// </para>
    /// </summary>
    private string SaveVariant => _form.Id is null
        ? "btn btn-primary"
        : "btn btn-secondary";

    /// <summary>
    /// The glyph beside it, following the same mode: the create mark when the dialog is making a
    /// record and the confirm mark when it is saving changes to one. The icon and the colour move
    /// together, because colour is never allowed to be the only signal.
    /// </summary>
    private IconName SaveGlyph => _form.Id is null ? IconName.Create : IconName.Confirm;

    private DriverForm _form = new();
    private DriverSummary? _pendingDeletion;
    private DtDialog? _formDialog;
    private DtConfirmDialog? _deleteDialog;
    private string _search = string.Empty;

    /// <summary>
    /// True while a save is in flight, which is what disables the submit button for as long as it
    /// lasts. The circuit yields at the await, so without it a second click would create a second
    /// driver account from the same form.
    /// </summary>
    private bool _saving;

    /// <summary>The row's edit action, bound as a delegate so no lambda has to live in markup.</summary>
    private Func<Task> EditHandler(DriverSummary driver) => () => OpenEditAsync(driver);

    /// <summary>The row's delete action, for the same reason.</summary>
    private Func<Task> DeleteHandler(DriverSummary driver) => () => OpenDeleteAsync(driver);

    protected override async Task OnInitializedAsync()
    {
        // The circuit outlives the request that opened it, so the cookie can be gone by the time a
        // screen calls a service. Raising the contract's own code here is what puts that case
        // through FR-13's single boundary instead of a per-screen redirect.
        if (!Caller.IsAuthenticated)
        {
            throw new ForbiddenException(
                ErrorCode.AUTH_UNAUTHENTICATED,
                "The circuit has no authenticated caller: the session cookie is gone.");
        }

        _vehicleChoices = ChoicesFor(await Fleet.ListUnassignedAsync(CircuitToken), driver: null);

        await base.OnInitializedAsync();
    }

    /// <inheritdoc />
    protected override DriverSort DefaultSort => DriverSort.LastName;

    /// <inheritdoc />
    protected override IReadOnlyCollection<DriverSort> Sortable { get; } =
    [
        DriverSort.FirstName,
        DriverSort.LastName,
        DriverSort.Email,
        DriverSort.LicenseNumber,
        DriverSort.Vehicle,
        DriverSort.Rating,
    ];

    /// <inheritdoc />
    protected override ListDriversQuery Compose(int offset, int limit, DriverSort sort, bool descending) =>
        new(offset, limit, sort.ToString(), descending, TableQuery.Text(SearchParameter));

    /// <inheritdoc />
    protected override (int Offset, int Limit, DriverSort Sort, bool Descending) Paging(ListDriversQuery view) =>
        (view.Offset, view.Limit, ListSort.Parse<DriverSort>(view.Sort) ?? DefaultSort, view.Descending);

    /// <inheritdoc />
    protected override ListDriversQuery Repaged(
        ListDriversQuery view,
        int offset,
        int limit,
        DriverSort sort,
        bool descending) =>
        view with { Offset = offset, Limit = limit, Sort = sort.ToString(), Descending = descending };

    /// <inheritdoc />
    protected override void AddFilters(ListDriversQuery view, IDictionary<string, object?> address) =>
        address[TableQuery.SearchName] = view.Search;

    /// <inheritdoc />
    protected override void Adopt(ListDriversQuery view) => _search = view.Search ?? string.Empty;

    /// <inheritdoc />
    protected override async Task<Paged<DriverSummary>?> FetchAsync(ListDriversQuery view) =>
        await Roster.ListAsync(view, CircuitToken);

    /// <summary>
    /// FR-36's search box changed: page one of what it now matches, replacing the history entry. The
    /// match itself - name, email, licence number and vehicle - is the server's, over every driver.
    /// </summary>
    private Task SearchChangedAsync() =>
        MoveAsync(FirstPage(View) with { Search = TableQuery.Text(_search) }, replace: true);

    /// <summary>
    /// The vehicles the assignment control offers: every vehicle nobody holds, plus the one
    /// this driver already holds when it is not among them.
    /// </summary>
    /// <remarks>
    /// A pure function, and internal so it can be tested directly, because the second half is
    /// the part that breaks silently. A driver's own vehicle is held, so it is absent from the
    /// unassigned list; a select whose current value is not among its options reads back as
    /// null, and the next save would release the vehicle. No render test would notice - static
    /// rendering opens no edit dialog - so until this lived here the rule was protected by a
    /// comment and nothing else.
    /// </remarks>
    /// <param name="unassigned">Every vehicle no driver holds (FR-45).</param>
    /// <param name="driver">The driver being edited, or null while creating one.</param>
    internal static IReadOnlyList<VehicleChoice> ChoicesFor(
        IReadOnlyList<VehicleSummary> unassigned,
        DriverSummary? driver)
    {
        ArgumentNullException.ThrowIfNull(unassigned);

        var choices = unassigned
            .Select(vehicle => new VehicleChoice(vehicle.Id, vehicle.Model, vehicle.LicensePlate))
            .ToList();

        if (driver?.VehicleId is { } vehicleId && !choices.Exists(choice => choice.Id == vehicleId))
        {
            choices.Insert(
                0,
                new VehicleChoice(
                    vehicleId,
                    driver.VehicleModel ?? string.Empty,
                    driver.VehicleLicensePlate ?? string.Empty));
        }

        return choices;
    }

    /// <summary>
    /// Refreshes only the choices the assignment control offers, which is all opening a dialog
    /// needs. Reloading the roster here would re-read every driver's account to answer a
    /// question about vehicles.
    /// </summary>
    /// <returns>False when the read was refused, in which case the failure is already on screen.</returns>
    private async Task<bool> LoadVehicleChoicesAsync(DriverSummary? driver)
    {
        try
        {
            _vehicleChoices = ChoicesFor(
                await Fleet.ListUnassignedAsync(CircuitToken),
                driver);

            return true;
        }
        catch (DriveTrackException failure)
        {
            // An @onclick handler sits inside nothing that would catch this: without the try, a
            // refused read escapes into the circuit's error boundary and the screen is gone.
            _failures = FailureKeys.For(failure);

            return false;
        }
    }

    private async Task OpenCreateAsync()
    {
        _failures = [];
        _form = new DriverForm();

        // Not opened when the choices could not be read: the refusal renders at page level,
        // where a dispatcher can see it, and a dialog whose vehicle list is stale is worse than
        // no dialog at all.
        if (!await LoadVehicleChoicesAsync(driver: null))
        {
            return;
        }

        if (_formDialog is not null)
        {
            await _formDialog.ShowAsync();
        }
    }

    private async Task OpenEditAsync(DriverSummary driver)
    {
        _failures = [];
        _form = new DriverForm
        {
            Id = driver.Id,
            FirstName = driver.FirstName,
            LastName = driver.LastName,
            LicenseNumber = driver.LicenseNumber,
            VehicleId = driver.VehicleId,
        };

        // The driver is passed in so ChoicesFor can add back the vehicle they already hold,
        // which the unassigned list does not carry.
        if (!await LoadVehicleChoicesAsync(driver))
        {
            return;
        }

        if (_formDialog is not null)
        {
            await _formDialog.ShowAsync();
        }
    }

    private async Task CloseFormAsync()
    {
        if (_formDialog is not null)
        {
            await _formDialog.CloseAsync();
        }
    }

    private async Task SaveAsync()
    {
        if (_saving)
        {
            return;
        }

        // Set before the await and cleared in the finally: the button is disabled from the moment
        // the first click is handled until the server has answered, so a second click has nothing
        // to act on.
        _saving = true;

        try
        {
            if (_form.Id is { } driverId)
            {
                await Roster.UpdateAsync(
                    driverId,
                    new UpdateDriverCommand(
                        Optional<string>.Present(_form.FirstName),
                        Optional<string>.Present(_form.LastName),
                        Optional<string>.Present(_form.LicenseNumber),
                        // Always present: this screen states the assignment it means, and an
                        // explicit null is FR-38's release.
                        Optional<int?>.Present(_form.VehicleId)),
                    CircuitToken);
            }

            if (_form.Id is null)
            {
                await Roster.CreateAsync(
                    new CreateDriverCommand(
                        _form.FirstName,
                        _form.LastName,
                        _form.Email,
                        _form.Password,
                        _form.LicenseNumber,
                        _form.VehicleId),
                    CircuitToken);
            }

            _failures = [];

            await CloseFormAsync();
        }
        catch (DriveTrackException failure)
        {
            // A refused save must not render the submitted password back.
            _form.Password = null;

            _failures = FailureKeys.For(failure);

            return;
        }
        finally
        {
            _saving = false;
        }

        // Outside the try, deliberately. The write has committed, so a failure refreshing the
        // list afterwards is a failed read: reporting it as a refused save would tell the
        // dispatcher their driver was not created, and blank the password that just worked.
        await LoadAsync();
    }

    private async Task OpenDeleteAsync(DriverSummary driver)
    {
        _failures = [];
        _pendingDeletion = driver;

        if (_deleteDialog is not null)
        {
            await _deleteDialog.ShowAsync();
        }
    }

    private async Task ConfirmDeleteAsync()
    {
        if (_pendingDeletion is not { } driver)
        {
            return;
        }

        _pendingDeletion = null;

        try
        {
            await Roster.DeleteAsync(driver.Id, CircuitToken);

            _failures = [];
        }
        catch (DriveTrackException failure)
        {
            _failures = FailureKeys.For(failure);

            return;
        }

        // Outside the try: the driver is gone, and a failed refresh afterwards must not be
        // reported as a delete that did not happen.
        await LoadAsync();
    }

    /// <summary>One vehicle as the assignment control offers it.</summary>
    /// <param name="Id">The id the select posts back.</param>
    /// <param name="Model">Make and model.</param>
    /// <param name="LicensePlate">The registration plate.</param>
    internal sealed record VehicleChoice(int Id, string Model, string LicensePlate);

    /// <summary>
    /// What the dialog is editing. A screen-local shape rather than a command: a command's fields
    /// are <c>Optional&lt;T&gt;</c>, and two-way binding needs somewhere plain to write.
    /// </summary>
    private sealed class DriverForm
    {
        /// <summary>The driver being edited, or null while creating one.</summary>
        public DriverId? Id { get; set; }

        public string? FirstName { get; set; }

        public string? LastName { get; set; }

        public string? Email { get; set; }

        public string? Password { get; set; }

        public string? LicenseNumber { get; set; }

        public int? VehicleId { get; set; }
    }
}
