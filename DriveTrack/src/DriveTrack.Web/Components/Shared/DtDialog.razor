@inject IJSRuntime JS
@inject IStringLocalizer<UiText> Localizer
@implements IAsyncDisposable

@* FR-85 / NFR-19: the one dialog every screen opens.

   A native <dialog> opened with showModal() - never with the `open` attribute - is what supplies
   focus trapping, Escape dismissal and focus restoration to the element that opened it. Those are
   three of NFR-19's four requirements, and the platform implements them better than a hand-rolled
   focus trap would. Bootstrap's modal would have meant wiring its JS bundle and a spray of
   framework data attributes for behaviour we already have.

   The ARIA trio is written out rather than left implicit: browsers do imply role="dialog" and
   modality from showModal(), but the attributes are what a test - and an audit - can read. *@

<dialog @ref="_element"
        class="@PanelClass"
        role="dialog"
        aria-modal="true"
        aria-labelledby="@_titleId">
    <div class="dt-dialog-panel">
        @* The head, and the Close that is always in it. A dialog opened with showModal() is
           dismissed with Escape and by the backdrop already, but neither is visible: on a phone
           there is no backdrop to reach and no Escape key to press, so the one way out that is
           always on screen is this button. It is deliberately not the same hook as the foot's
           default close - the foot's appears only when a screen supplied no actions of its own,
           and a test that could not tell the two apart would pass on a dialog with no way out. *@
        <div class="dt-dialog-head">
            @* The heading block: the title, and under it the one muted line a dialog may carry to
               say what it is about - the timeline's route - so the reader need not hold the row
               they pressed in their head. *@
            <div class="dt-dialog-heading">
                <h2 id="@_titleId" class="dt-dialog-title dt-type-h2">@Title</h2>
                @if (Subtitle is not null)
                {
                    <p class="dt-dialog-subtitle">@Subtitle</p>
                }
            </div>

            @* The trailing block: whatever the screen puts beside the dismiss - a status label, for
               the timeline - and the dismiss itself, always last and always there. *@
            <div class="dt-dialog-head-end">
                @HeadContent

                <button type="button" class="btn btn-link dt-dialog-dismiss dt-icon-only"
                        aria-label="@Localizer["Close"]" @onclick="CloseAsync">
                    <Icon Name="IconName.Close" />
                </button>
            </div>
        </div>

        @* The body scrolls and the head and foot do not, so a long form on a short screen still
           shows its title and its actions rather than pushing them past the edge. *@
        <div class="dt-dialog-body">
            @ChildContent
        </div>

        @* Only when the screen brought actions of its own. A dialog that brought none used to get
           a Close button here, which was a second way out beside the dismiss in the head - the
           same act, offered twice, with a bordered strip across the panel to hold it. The head's
           dismiss is the way out of a dialog that has nothing to decide, and a footer with one
           redundant control in it is a footer worth not drawing. *@
        @if (Actions is not null)
        {
            <div class="dt-dialog-actions">
                @Actions
            </div>
        }
    </div>
</dialog>

@code {
    /// <summary>
    /// The path the collocated module is served from. Not fingerprinted: `Assets[...]` resolves a
    /// hashed href for a declarative &lt;script&gt; tag, and MapStaticAssets serves the plain path
    /// as well, which is the one an `import()` can name from C#.
    /// </summary>
    private const string ModulePath = "./Components/Shared/DtDialog.razor.js";

    /// <summary>
    /// Generated rather than a parameter: two dialogs on one screen must not share an id, and
    /// aria-labelledby is only correct if it points at *this* dialog's heading.
    /// </summary>
    private readonly string _titleId = $"dt-dialog-title-{Guid.NewGuid():N}";

    private ElementReference _element;
    private IJSObjectReference? _module;
    private DotNetObjectReference<DtDialog>? _self;

    /// <summary>The dialog's heading, already localized by the screen that opens it.</summary>
    /// <remarks>
    /// Required: aria-labelledby points at the heading, so a dialog opened without one is a modal
    /// with no accessible name - and it looks fine on screen.
    /// </remarks>
    [Parameter]
    [EditorRequired]
    public string? Title { get; set; }

    /// <summary>
    /// One muted line under the title saying what the dialog is about, already localized, or null
    /// for none. Every dialog that does not set it renders exactly as it did.
    /// </summary>
    [Parameter]
    public string? Subtitle { get; set; }

    /// <summary>
    /// Content drawn in the head beside the dismiss, before it - a status label, say. Null draws
    /// nothing, so the dismiss stays the only thing at the head's trailing edge.
    /// </summary>
    [Parameter]
    public RenderFragment? HeadContent { get; set; }

    /// <summary>The dialog's body.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// The screen's own actions. When none are supplied the dialog renders its own close action
    /// instead, so a dialog can never be opened with no visible way out.
    /// </summary>
    [Parameter]
    public RenderFragment? Actions { get; set; }

    /// <summary>
    /// Raised once for every dismissal, whatever caused it - Escape, the backdrop, or the close
    /// action. The module routes all three through the element's own `close` event, so there is
    /// one path rather than three.
    /// </summary>
    [Parameter]
    public EventCallback OnClosed { get; set; }

    /// <summary>
    /// Widens the panel for a dialog holding two inputs side by side. Off by default, because the
    /// narrow width is what keeps a line of prose readable on a desktop; a dialog asks for this
    /// only when its content is laid out in columns and the default would squeeze them.
    /// </summary>
    [Parameter]
    public bool Wide { get; set; }

    /// <summary>
    /// Widens the panel to the medium ceiling: a history above a form, where the narrow width
    /// would wrap every entry's meta line and the wide one leaves a line of prose too long to
    /// read. <see cref="Wide"/> wins when both are set.
    /// </summary>
    [Parameter]
    public bool Medium { get; set; }

    /// <summary>
    /// The panel's classes, resolved here rather than written as a ternary in the attribute — the
    /// reason <c>DtFailureBanner</c> resolves its label into a local. Unset <see cref="Wide"/>
    /// leaves the class exactly as it was, so every existing dialog renders unchanged.
    /// </summary>
    private string PanelClass => (Wide, Medium) switch
    {
        (true, _) => "dt-dialog dt-dialog-wide",
        (false, true) => "dt-dialog dt-dialog-medium",
        _ => "dt-dialog",
    };

    /// <summary>Opens the dialog modally.</summary>
    public async Task ShowAsync()
    {
        _self ??= DotNetObjectReference.Create(this);
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", ModulePath);

        await _module.InvokeVoidAsync("open", _element, _self);
    }

    /// <summary>Closes the dialog. A dialog that was never opened has nothing to close.</summary>
    public async Task CloseAsync()
    {
        if (_module is null)
        {
            return;
        }

        await _module.InvokeVoidAsync("close", _element);
    }

    /// <summary>Called by the module when the element's `close` event fires.</summary>
    [JSInvokable]
    public Task NotifyClosedAsync() => OnClosed.InvokeAsync();

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit went away before the component did. There is no module left to
                // release, and throwing here would replace a disconnect with an unhandled error.
            }
        }

        _self?.Dispose();
    }
}
