@page "/register"
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Components.Endpoints
@* Statically rendered for the same reason as SignIn: the form POST has to be able to write the
   authentication cookie, and a circuit has no response to write it to. *@
@attribute [ExcludeFromInteractiveRouting]
@attribute [AllowAnonymous]
@layout AuthLayout
@inject IUserService Users
@inject IStringLocalizer<UiText> Localizer
@inject NavigationManager Navigation

<PageTitle>@Localizer["RegisterTitle"]</PageTitle>

@* The panel, written the way SignIn writes it: `dt-auth-panel` is what the two screens share,
   `dt-register-panel` is this screen's width on its own wrapper, and the card is titleless with a
   bare <h1> in its body for SignIn's reasons - a form has no status for a glyph to report. *@
<div class="dt-auth-panel dt-register-panel">
    <DtCard>
        <h1 class="dt-type-h1">@Localizer["RegisterTitle"]</h1>
        <p class="dt-muted dt-auth-panel__subtitle">@Localizer["RegisterSubtitle"]</p>

        @* In the card, on the same measure as the form it refuses. Every refusal about one box moves
           under that box - AUTH_EMAIL_ALREADY_IN_USE included, which the service raises with no
           field and FailureKeys pins to Email. What is left here is what no box on the form is
           about. *@
        <DtFailureBanner Failures="_failures" InlineFields="@InlineFields" />

        @* No `required` and no `type="email"` on the boxes, whatever the artboard's markup says: a
           browser bubble would stand in front of the server's own field errors. *@
        <EditForm Model="Form!" FormName="register" OnValidSubmit="SubmitAsync">
            <div class="dt-auth-panel__names">
                <div>
                    <label class="form-label" for="register-first-name">@Localizer["FirstName"]</label>
                    @* One token per box, so a password manager fills the account it is about to store rather
                       than guessing from the labels. *@
                    <InputText id="register-first-name" class="form-control" autocomplete="given-name"
                               @bind-Value="Form!.FirstName" />
                    <DtFieldError Field="FirstName" Failures="_failures" />
                </div>
                <div>
                    <label class="form-label" for="register-last-name">@Localizer["LastName"]</label>
                    <InputText id="register-last-name" class="form-control" autocomplete="family-name"
                               @bind-Value="Form!.LastName" />
                    <DtFieldError Field="LastName" Failures="_failures" />
                </div>
            </div>
            <div>
                <label class="form-label" for="register-email">@Localizer["Email"]</label>
                <InputText id="register-email" class="form-control" autocomplete="email"
                           @bind-Value="Form!.Email" />
                <DtFieldError Field="Email" Failures="_failures" />
            </div>
            <div>
                <label class="form-label" for="register-phone">@Localizer["PhoneNumber"]</label>
                @* The placeholder is a number the validator accepts, so it is written with no spaces
                   where the artboard draws them: copying the example must not be refused. *@
                <InputText id="register-phone" type="tel" class="form-control" autocomplete="tel"
                           placeholder="@Localizer["PhoneNumberPlaceholder"]"
                           aria-describedby="register-phone-hint"
                           @bind-Value="Form!.PhoneNumber" />
                @* The hint stays a `form-text`: it is the framework's own quiet sentence under a
                   box, and the shape a phone number has to take is a rule about that one box. *@
                <div class="form-text dt-type-small" id="register-phone-hint">@Localizer["PhoneNumberHint"]</div>
                <DtFieldError Field="PhoneNumber" Failures="_failures" />
            </div>
            <div>
                <label class="form-label" for="register-password">@Localizer["Password"]</label>
                @* `new-password` on both halves, which is what stops a manager offering the stored
                   password of whoever last signed in on this browser and what prompts it to
                   suggest one instead. *@
                <InputText id="register-password" type="password" class="form-control"
                           autocomplete="new-password" @bind-Value="Form!.Password" />
                <DtFieldError Field="Password" Failures="_failures" />
            </div>
            <div>
                <label class="form-label" for="register-password-confirmation">@Localizer["PasswordConfirmation"]</label>
                <InputText id="register-password-confirmation" type="password" class="form-control"
                           autocomplete="new-password" @bind-Value="Form!.PasswordConfirmation" />
                <DtFieldError Field="PasswordConfirmation" Failures="_failures" />
            </div>

            @* NFR-24, and no `disabled` binding for the reason SignIn's submit carries none: there
               is no circuit behind this page to flip one. *@
            <button class="btn btn-primary dt-register-submit" type="submit">
                <Icon Name="IconName.Register" />@Localizer["LandingCreateAccount"]
            </button>
        </EditForm>

        <p class="dt-auth-panel__switch">@Localizer["HaveAccount"] <a href="/sign-in">@Localizer["SignIn"]</a></p>
    </DtCard>
</div>

@code {
    /// <summary>
    /// The boxes this screen renders a <c>DtFieldError</c> for. Stated once and bound by every
    /// banner on the page: the list repeated per banner is exactly the drift FR-83 is broken by,
    /// and a screen carries the banner more than once because a dialog opened with showModal()
    /// leaves the page behind it inert.
    /// </summary>
    private const string InlineFields = "FirstName,LastName,Email,PhoneNumber,Password,PasswordConfirmation";

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // See SignIn.razor: nullable with no initializer, because the form binder can overwrite an
    // initialized property with null (BL0008).
    [SupplyParameterFromForm]
    private RegisterInput? Form { get; set; }

    // The property is named Form because the input names the browser posts back are derived from
    // the binding expression - name="Form.Email" - while the form binder looks the model up by this
    // property's name. Different names on the two sides bind nothing, silently.
    protected override void OnInitialized() => Form ??= new RegisterInput();

    private IReadOnlyList<ScreenFailure> _failures = [];

    private async Task SubmitAsync()
    {
        try
        {
            var session = await Users.RegisterClientAsync(
                new RegisterClientCommand(
                    Form!.FirstName,
                    Form!.LastName,
                    Form!.Email,
                    Form!.PhoneNumber,
                    Form!.Password,
                    Form!.PasswordConfirmation),
                HttpContext.RequestAborted);

            // Always persistent: the person has just created the account on this very device, so there
            // is no one else's session it could outlive.
            await HttpContext.SignInAsync(
                AuthenticationSchemes.Cookie,
                ClaimsFactory.Build(session),
                new AuthenticationProperties { IsPersistent = true });

            Navigation.NavigateTo(LandingRoute.For(session.Role));
        }
        catch (DriveTrackException failure)
        {
            // See SignIn.razor: a refused post must not render the submitted password back.
            Form!.Password = null;
            Form.PasswordConfirmation = null;

            _failures = FailureKeys.For(failure);
        }
    }

    private sealed class RegisterInput
    {
        public string? FirstName { get; set; }

        public string? LastName { get; set; }

        public string? Email { get; set; }

        public string? PhoneNumber { get; set; }

        public string? Password { get; set; }

        public string? PasswordConfirmation { get; set; }
    }
}
